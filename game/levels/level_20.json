{
  "name": "Scarlands",
  "id": "scarlands",
  "next": "level_21.json",
  "speed": 130,
  "segmentLength": 60,
  "music": "pulse",

  // Block C opens here: two shields in - the refills are getting weaker - then one new idea alone.
  // Hazard plates: wall that cannot be shot, broken or rammed, only flown around. Every other
  // obstacle has a way out, including unstoppable, which turns any collision into a free break.
  // A plate is the one thing that stays.
  // There is deliberately NO unstoppable anywhere in this level. Meeting a plate for the first time
  // mid-ram would read as a bug rather than a rule. It comes back in 19, once plates are known.
  "theme": {
    "darks": ["#2e2016", "#261a12", "#38271b"],
    "lights": ["#b08a5c", "#98754d", "#c49a68" ],
    "seamDark": "#170f08",
    "seamLight": "#ffd9a0",
    "far": "#0b0704",
    "ship": "#ffd9a0",
    "block": "#d6c3a8",
    "target": "#ff5a3a",
    "breakable": "#9adfff",
    "fadeStart": 35,
    "fadeEnd": 340,
    "glow": 0.25
  },

  "sections": {
    "tube": { "radius": 6 },
    "box":  { "halfWidth": 9.5, "halfHeight": 4.2, "squareness": 1 },
    "flat": { "radius": 6, "opening": 1 },
    "wide": { "radius": 7.5 }
  },

  "start": "tube",
  "track": [
    // The block's refill, weaker than A's and B's: two shields, not a full bar.
    { "length": 370, "pickups": [                                   //    0 -  370
      { "at": 290, "kind": "shield" },
      { "at": 360, "kind": "shield", "angle": 180 }
    ] },

    // FREE LOOK. One plate, in a wide bore, taking a quarter of the wall. Shoot it all you like.
    { "length": 170, "section": "wide", "obstacles": [              //  370 -  540
      { "at": 160, "kind": "plate", "angle": 90, "width": 12, "height": 3 }
    ] },

    // Rapid fire, then a wall of blocks with a plate in the middle of it. The blocks give way; the
    // plate does not, so the gap that matters is the one the shooting cannot make.
    { "length": 340, "section": "tube", "pickups": [                //  540 -  880
      { "at": 70, "kind": "rapid-fire" },
      { "at": 250, "kind": "agility", "angle": 0 }
    ], "obstacles": [
      { "at": 190, "hits": 2, "angle": 0,   "width": 9 },
      { "at": 190, "kind": "plate", "angle": 120, "width": 11, "height": 3 },
      { "at": 190, "hits": 2, "angle": 240, "width": 9 },
      { "at": 300, "kind": "target", "angle": 180 }
    ] },

    // Plates in pairs, leaving one lane open between them. Pure steering: no tool touches these.
    { "length": 400, "turn": 40, "obstacles": [                     //  880 - 1280
      { "at": 100, "kind": "plate", "angle": 60,   "width": 12, "height": 3 },
      { "at": 100, "kind": "plate", "angle": -60,  "width": 12, "height": 3 },
      { "at": 230, "kind": "plate", "angle": 180,  "width": 12, "height": 3 },
      { "at": 230, "kind": "plate", "angle": 0,    "width": 12, "height": 3 },
      { "at": 340, "kind": "plate", "angle": 120,  "width": 12, "height": 3 }
    ] },

    { "length": 260, "section": "wide", "speed": 140, "pickups": [  // 1280 - 1540
      { "at": 130, "kind": "shield", "angle": 90 }
    ] },

    // The box. Flat floor and ceiling, plates across the corners, so the readable shape of a squarish
    // section works against the player for once.
    { "length": 380, "section": "box", "speed": 145, "obstacles": [ // 1540 - 1920
      { "at": 90,  "kind": "plate", "angle": 0,   "width": 13, "height": 3 },
      { "at": 200, "kind": "plate", "angle": 180, "width": 13, "height": 3 },
      { "at": 200, "kind": "target", "angle": 90 },
      { "at": 310, "kind": "plate", "angle": 90,  "width": 11, "height": 3 }
    ] },

    // Flat: plates as full-width walls would be impassable, so here they are partial and the jump is
    // the way past. A plate has no answer in the tools, but it always has an answer in the track.
    { "length": 120, "section": "flat", "speed": 140 },             // 1920 - 2040
    { "length": 420, "obstacles": [                                 // 2040 - 2460
      { "at": 100, "kind": "plate", "x": -14, "width": 26, "height": 2.5 },
      { "at": 100, "kind": "plate", "x": 16,  "width": 22, "height": 2.5 },
      { "at": 230, "width": 80, "height": 2.5 },
      { "at": 300, "kind": "plate", "surface": "ceiling", "x": -12, "width": 24, "height": 2.5 },
      { "at": 380, "kind": "target", "surface": "ceiling", "x": 14 }
    ] },

    { "length": 260, "section": "tube", "speed": 145, "pickups": [  // 2460 - 2720
      { "at": 130, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 200, "kind": "target", "angle": 0, "count": 4, "angleStep": 90 }
    ] },

    // Plates narrowing the only line, with a shield past them worth the squeeze.
    // A well among the plates. Both are things no tool answers, so the whole stretch is steering -
    // but one of them costs a shield and the other costs the clock.
    { "length": 380, "turn": -45, "pickups": [                      // 2720 - 3100
      { "at": 330, "kind": "shield", "angle": 0 }
    ], "warps": [
      { "at": 150, "angle": -90 }
    ], "obstacles": [
      { "at": 110, "kind": "plate", "angle": 90,  "width": 13, "height": 3 },
      { "at": 210, "kind": "plate", "angle": -90, "width": 13, "height": 3 },
      { "at": 210, "kind": "plate", "angle": 180, "width": 11, "height": 3 }
    ] },

    // Run for home: a plate at each bend of a twist, unseen until it is close and unanswerable when
    // it arrives. The only way through is to have kept enough speed in hand to steer.
    { "length": 200, "speed": 155, "turn": 70, "obstacles": [       // 3100 - 3300
      { "at": 110, "kind": "plate", "angle": 0, "width": 12, "height": 3 }
    ] },
    { "length": 200, "turn": -75, "climb": 12, "obstacles": [       // 3300 - 3500
      { "at": 100, "kind": "plate", "angle": 180, "width": 12, "height": 3 }
    ] },
    { "length": 200, "turn": 65, "climb": -14, "obstacles": [       // 3500 - 3700
      { "at": 100, "kind": "plate", "angle": 90, "width": 12, "height": 3 }
    ] },

    // Handover to Crossfire: straighten and blend into its tube, then the first 276 units of its
    // track, so the camera sees the same tube on both sides of the join. Nothing to hit out here; the
    // level finishes 16 units into this copy, which is where the next level places the ship.
    { "length": 120, "speed": 140, "section": "tube" },                           // 3700 - 3820
    { "length": 200 },                                              // 3820 - 4020
    { "length": 76, "turn": 7 }                                     // 4020 - 4096
  ]
}
