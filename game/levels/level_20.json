{
  "name": "Keys",
  "next": "level_21.json",
  "speed": 140,
  "segmentLength": 60,

  // Shoot-to-open gates: a target that unlocks a wall further down the track. Shooting buys passage
  // instead of points, and missing means arriving at something solid.
  // The distance between a key and its door is the entire design lever. Too close and there is no
  // time to react; too far and the key is forgotten. Every pairing here gives the shot time to land
  // and the door time to be seen - and the doors are wide, so an unopened one really is a wall.
  "theme": {
    "darks": ["#101f2a", "#0d1922", "#152633"],
    "lights": ["#5e8fa8", "#4e7a91", "#6d9fb8"],
    "seamDark": "#060e14",
    "seamLight": "#b6f0ff",
    "far": "#03070a",
    "ship": "#b6f0ff",
    "block": "#dfeef7",
    "target": "#ffd23a",
    "breakable": "#7cffb0",
    "fadeStart": 35,
    "fadeEnd": 345,
    "glow": 0.35
  },

  "sections": {
    "tube": { "radius": 6 },
    "wide": { "radius": 7.5 },
    "oval": { "halfWidth": 9, "halfHeight": 4.5 },
    "box":  { "halfWidth": 9.5, "halfHeight": 4.2, "squareness": 1 },
    "chamber":      { "halfWidth": 14, "halfHeight": 6.5, "squareness": 0.6 },
    "branch":       { "radius": 6 },
    "branch-tight": { "radius": 4.5 }
  },

  "start": "tube",
  "track": [
    { "length": 220 },                                              //    0 -  220

    // FREE LOOK. One key, one door, well apart and both on the floor line. Shoot it and fly through;
    // do not, and the door costs a shield. Nothing else on the stretch.
    { "length": 420, "section": "wide", "obstacles": [              //  220 -  640
      { "at": 120, "kind": "target", "group": "k1" },
      { "at": 320, "lockedBy": "k1", "width": 26, "height": 3 }
    ] },

    // Two pairs, keys and doors interleaved, so which key opens which door has to be tracked.
    { "length": 460, "section": "tube", "pickups": [                //  640 - 1100
      { "at": 60, "kind": "rapid-fire" }
    ], "obstacles": [
      { "at": 120, "kind": "target", "angle": 90,  "group": "k2" },
      { "at": 170, "kind": "target", "angle": -90, "group": "k3" },
      { "at": 320, "lockedBy": "k2", "angle": 0,   "width": 22, "height": 3 },
      { "at": 410, "lockedBy": "k3", "angle": 180, "width": 22, "height": 3 }
    ] },

    // A door with two keys: both have to go, and they sit on opposite walls, so opening it costs
    // real travel around the tube as well as two shots.
    { "length": 440, "turn": 40, "obstacles": [                     // 1100 - 1540
      { "at": 110, "kind": "target", "angle": 90,  "group": "k4" },
      { "at": 210, "kind": "target", "angle": -90, "group": "k4" },
      { "at": 370, "lockedBy": "k4", "angle": 0, "width": 24, "height": 3 }
    ] },

    { "length": 260, "section": "oval", "speed": 150, "pickups": [  // 1540 - 1800
      { "at": 130, "kind": "shield", "angle": 180 }
    ] },

    // Keys behind plates: the shot has to be taken from a line the plates allow. The door is wide
    // enough that missing the window means stopping hard or paying for it.
    { "length": 460, "section": "tube", "obstacles": [              // 1800 - 2260
      { "at": 120, "kind": "plate", "angle": 45,  "width": 11, "height": 3 },
      { "at": 180, "kind": "target", "angle": 180, "group": "k5" },
      { "at": 250, "kind": "plate", "angle": -45, "width": 11, "height": 3 },
      { "at": 390, "lockedBy": "k5", "angle": 0, "width": 24, "height": 3 }
    ] },

    // A key on a mover: it slides while the shot is lined up, so the aim has to lead it - and the
    // door is close enough behind that a missed first shot is felt.
    { "length": 440, "speed": 155, "turn": -45, "obstacles": [      // 2260 - 2700
      { "at": 130, "kind": "target", "sweep": 9, "sweepTime": 3.2, "angle": 0, "group": "k6" },
      { "at": 350, "lockedBy": "k6", "angle": 90, "width": 24, "height": 3 }
    ] },

    { "length": 240, "section": "wide", "pickups": [                // 2700 - 2940
      { "at": 120, "kind": "ring-gun" }
    ] },

    // A fork whose short road is locked: the key stands in the chamber before it, so the branch has
    // to be paid for with a shot taken before the fork is even reached.
    { "length": 160, "section": "chamber", "speed": 160, "obstacles": [   // 2940 - 3100
      { "at": 70, "kind": "target", "angle": 90, "group": "kf" }
    ] },
    { "length": 440, "turn": 85, "split": {                         // 3100 - 3540
        "section": "branch",
        "branches": [
          { "offsets": [[0, -8, 0], [150, -32, 0], [290, -32, 0], [440, -8, 0]] },
          { "offsets": [[0, 8, 0], [150, 32, 0], [290, 32, 0], [440, 8, 0]], "section": "branch-tight" }
        ]
      },
      "obstacles": [
        { "at": 210, "branch": 0, "kind": "target", "angle": 90 },
        { "at": 120, "branch": 1, "lockedBy": "kf", "angle": 0, "width": 20, "height": 3 }
      ]
    },
    { "length": 140, "section": "tube" },                           // 3540 - 3680

    // A key that is part of an ordered group: the ring gun cannot touch it, and it will not break
    // until its turn. Two mechanics stacked, and the door behind them does not care.
    { "length": 480, "section": "box", "speed": 160, "obstacles": [ // 2940 - 3420
      { "at": 110, "kind": "target", "angle": 90,  "group": "k7", "order": 0 },
      { "at": 200, "kind": "target", "angle": -90, "group": "k7", "order": 1 },
      { "at": 400, "lockedBy": "k7", "angle": 0, "width": 26, "height": 3 }
    ] },

    { "length": 240, "section": "tube", "pickups": [                // 3420 - 3660
      { "at": 120, "kind": "shield", "angle": 90 }
    ] },

    // Run for home: a key before each bend of a twist, its door round the corner out of sight. The
    // shot has to be taken on faith, before the thing it opens can be seen at all.
    { "length": 220, "speed": 165, "turn": 70, "obstacles": [       // 3660 - 3880
      { "at": 70,  "kind": "target", "angle": 0, "group": "k8" },
      { "at": 180, "lockedBy": "k8", "angle": 0, "width": 22, "height": 3 }
    ] },
    { "length": 220, "turn": -75, "climb": 14, "obstacles": [       // 3880 - 4100
      { "at": 70,  "kind": "target", "angle": 180, "group": "k9" },
      { "at": 180, "lockedBy": "k9", "angle": 180, "width": 22, "height": 3 }
    ] },

    { "length": 260 }                                               // 4100 - 4360
  ]
}
