{
  "name": "Roulette",
  "next": "level_23.json",
  "speed": 145,
  "segmentLength": 60,

  // Block D opens here: one shield in - the weakest refill of the four blocks - then the last new
  // idea, which needs no new code at all. A fork where one branch hides a warp well.
  // A fork was always time against shields: the short way is tighter and meaner. Putting a well down
  // one branch adds a third thing to weigh, and it is the only one that can cost more than the fork
  // saves - a warp throws the ship back up the track, so taking the quick way and hitting the well
  // is worse than having taken the long way at all.
  // The signs are the tell. A ring of them stands 75 units before every well, so the gamble is
  // informed: the player can see which branch is carrying one before committing to it.
  "theme": {
    "darks": ["#1d1526", "#17111e", "#251b30"],
    "lights": ["#8d6fb5", "#795c9e", "#a084c4"],
    "seamDark": "#0e0a13",
    "seamLight": "#dcb8ff",
    "far": "#060409",
    "ship": "#dcb8ff",
    "block": "#c9b8dd",
    "target": "#ffcf3a",
    "breakable": "#7cffc4",
    "fadeStart": 35,
    "fadeEnd": 345,
    "glow": 0.35
  },

  "sections": {
    "tube":         { "radius": 6 },
    "chamber":      { "halfWidth": 14, "halfHeight": 6.5, "squareness": 0.6 },
    "wide-chamber": { "halfWidth": 19, "halfHeight": 6.5, "squareness": 0.6 },
    "branch":       { "radius": 6 },
    "branch-mid":   { "radius": 5 },
    "branch-tight": { "radius": 4.5 },
    "oval":         { "halfWidth": 9, "halfHeight": 4.5 }
  },

  "start": "tube",
  "track": [
    // The block's refill: a single shield.
    { "length": 240, "pickups": [                                   //    0 -  240
      { "at": 120, "kind": "shield" }
    ] },

    // FREE LOOK at the pairing. A wide chamber, then a fork whose quick branch is clean - no well
    // anywhere. This is the fork the player already knows, so the next one can break the pattern.
    { "length": 120, "section": "chamber", "speed": 150 },          //  240 -  360
    { "length": 420, "turn": 80, "split": {                         //  360 -  780
        "section": "branch",
        "branches": [
          { "offsets": [[0, -8, 0], [140, -30, 0], [280, -30, 0], [420, -8, 0]] },
          { "offsets": [[0, 8, 0], [140, 30, 0], [280, 30, 0], [420, 8, 0]], "section": "branch-tight" }
        ]
      },
      "obstacles": [
        { "at": 210, "branch": 0, "kind": "target" },
        { "at": 140, "branch": 1, "angle": 0, "count": 3, "spacing": 60, "angleStep": 90 }
      ]
    },
    { "length": 140, "section": "tube" },                           //  780 -  920

    // Now the gamble. Same shape, but the quick branch carries a well on its outer wall - where the
    // tube curves away from the ship, so it is presented rather than seen edge-on. The signs are
    // visible before the fork, so this is a choice and not an ambush.
    { "length": 120, "section": "chamber", "speed": 155, "pickups": [    //  920 - 1040
      { "at": 60, "kind": "rapid-fire" }
    ] },
    { "length": 440, "turn": 85, "split": {                         // 1040 - 1480
        "section": "branch",
        "branches": [
          { "offsets": [[0, -8, 0], [150, -32, 0], [290, -32, 0], [440, -8, 0]] },
          { "offsets": [[0, 8, 0], [150, 32, 0], [290, 32, 0], [440, 8, 0]], "section": "branch-tight" }
        ]
      },
      "warps": [
        { "at": 300, "branch": 1, "angle": 90 }
      ],
      "obstacles": [
        { "at": 220, "branch": 0, "kind": "target", "angle": 90 },
        { "at": 150, "branch": 1, "angle": 0, "count": 2, "spacing": 70, "angleStep": 120 }
      ]
    },
    { "length": 160, "section": "tube" },                           // 1480 - 1640

    { "length": 280, "section": "oval", "speed": 160, "pickups": [  // 1640 - 1920
      { "at": 140, "kind": "shield", "angle": 180 }
    ], "obstacles": [
      { "at": 220, "kind": "target", "angle": 90 }
    ] },

    // A three-way. The middle road is the centreline: no saving, no well, nothing. Left is long and
    // clear. Right is quickest, tightest, and carries the well. The safe answer is the boring one.
    // A three-way needs room for three openings side by side at the fork. Three branches of radius 6
    // want 36 units of width and a halfWidth-14 chamber offers 28, so this one widens out and the
    // branches themselves are narrower - which suits it, being the tightest choice in the level.
    { "length": 140, "section": "wide-chamber", "speed": 160 },     // 1920 - 2060
    { "length": 480, "turn": 100, "split": {                        // 2060 - 2540
        "section": "branch-mid",
        "branches": [
          // Only the fork and merge openings are checked, so these stay tucked in; the mid-split
          // offsets are free to swing as wide as the saving needs.
          { "offsets": [[0, -12, 0], [160, -44, 0], [320, -44, 0], [480, -12, 0]] },
          { "offsets": [[0, 0, 0], [160, 0, 0], [320, 0, 0], [480, 0, 0]] },
          { "offsets": [[0, 12, 0], [160, 44, 0], [320, 44, 0], [480, 12, 0]], "section": "branch-tight" }
        ]
      },
      "pickups": [
        { "at": 280, "branch": 2, "kind": "full-shields" }
      ],
      "warps": [
        { "at": 350, "branch": 2, "angle": 90 }
      ],
      "obstacles": [
        { "at": 240, "branch": 0, "kind": "target" },
        { "at": 160, "branch": 1, "angle": 0, "count": 3, "spacing": 80, "angleStep": 120 },
        { "at": 150, "branch": 2, "angle": 180, "count": 2, "spacing": 60 }
      ]
    },
    { "length": 160, "section": "chamber" },                        // 2540 - 2700
    { "length": 140, "section": "tube" },                           // 2700 - 2840

    // A well on the main line, to say the mechanic is not only a branch thing.
    { "length": 380, "turn": -60, "speed": 165, "warps": [          // 2700 - 3080
      { "at": 220, "angle": 90 }
    ], "obstacles": [
      { "at": 100, "angle": 180, "width": 9 }
    ] },

    { "length": 240, "pickups": [                                   // 3080 - 3320
      { "at": 120, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 180, "kind": "target", "angle": 0, "count": 4, "angleStep": 90 }
    ] },

    // Run for home: a last fork, both branches carrying a well, so there is no clean way through -
    // only a choice of which risk. The long way's well sits where the wall curves most.
    { "length": 140, "section": "chamber", "speed": 170 },          // 3320 - 3460
    { "length": 440, "turn": -90, "split": {                        // 3460 - 3900
        "section": "branch",
        "branches": [
          { "offsets": [[0, -8, 0], [150, -32, 0], [290, -32, 0], [440, -8, 0]], "section": "branch-tight" },
          { "offsets": [[0, 8, 0], [150, 32, 0], [290, 32, 0], [440, 8, 0]] }
        ]
      },
      "warps": [
        { "at": 260, "branch": 0, "angle": -90 },
        { "at": 320, "branch": 1, "angle": 90 }
      ],
      "obstacles": [
        { "at": 150, "branch": 0, "angle": 0, "count": 2, "spacing": 60, "angleStep": 120 },
        { "at": 180, "branch": 1, "kind": "target", "angle": 180 }
      ]
    },
    { "length": 300, "section": "tube" }                            // 3900 - 4200
  ]
}
