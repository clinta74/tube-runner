{
  "name": "Clockwork",
  "id": "clockwork",
  "next": "level_13.json",
  "speed": 105,
  "segmentLength": 60,

  // Block A opens here: full shields on the way in, then one new idea taught on its own.
  // Timed gates - solid for half a cycle, gone for the other half. The throttle is the answer, which
  // is why this is the first of the late mechanics: the player has had a speed control since level 3
  // and has never once been asked to use it as timing.
  "theme": {
    "darks": ["#1b2430", "#16202b", "#232b38"],
    "lights": ["#7f96ad", "#6d8499", "#8d9bb2"],
    "seamDark": "#0d1319",
    "seamLight": "#9fe8ff",
    "far": "#060a0e",
    "ship": "#9fe8ff",
    "block": "#c3d2e2",
    "target": "#ff5a7a",
    "breakable": "#7cc4ff",
    "fadeStart": 35,
    "fadeEnd": 340,
    "glow": 0.25
  },

  "sections": {
    "tube": { "radius": 6 },
    "oval": { "halfWidth": 9, "halfHeight": 4.5 },
    "wide": { "radius": 7 }
  },

  "start": "tube",
  "track": [
    // The refill that opens the block. Nothing else here: a new mechanic is about to be taught, and
    // learning one on a last shield is how a run dies to unfairness rather than difficulty.
    { "length": 320, "pickups": [                                   //    0 -  320
      { "at": 290, "kind": "full-shields" }
    ] },

    // FREE LOOK. One gate, on a straight, with nothing else going on. It is a quarter of the way
    // round the tube, so it can simply be flown around - the point is to watch it open and shut.
    { "length": 160, "section": "wide", "obstacles": [              //  320 -  480
      { "at": 130, "period": 2.4, "angle": 90, "width": 9, "height": 3 }
    ] },

    // Now one that cannot be dodged: it spans the floor. Slow into it or hurry - either reads.
    { "length": 240, "section": "tube", "obstacles": [              //  480 -  720
      { "at": 120, "period": 2.6, "angle": 0, "width": 20, "height": 3 }
    ] },

    // A pair in opposite phase: whichever is open is the way through. This is the shape the rest of
    // the level builds on, and it is a steering problem as much as a timing one.
    { "length": 300, "turn": 30, "obstacles": [                     //  720 - 1020
      { "at": 110, "period": 2.6, "phase": 0,   "angle": 0,   "width": 20, "height": 3 },
      { "at": 110, "period": 2.6, "phase": 0.5, "angle": 180, "width": 20, "height": 3 },
      { "at": 230, "period": 2.6, "phase": 0.5, "angle": 0,   "width": 20, "height": 3 },
      { "at": 230, "period": 2.6, "phase": 0,   "angle": 180, "width": 20, "height": 3 }
    ] },

    { "length": 200, "section": "oval", "speed": 115, "pickups": [  // 1020 - 1220
      { "at": 90, "kind": "rapid-fire" }
    ], "obstacles": [
      { "at": 150, "kind": "target", "angle": 90 }
    ] },

    // Gates mixed with ordinary blocks, so reading which is which matters. The blocks are the ones
    // that never move; arriving expecting a gate to open is the mistake this stretch sells.
    { "length": 340, "section": "tube", "turn": -40, "obstacles": [ // 1220 - 1560
      { "at": 60,  "angle": 90, "width": 8 },
      { "at": 140, "period": 2.2, "angle": -90, "width": 16, "height": 3 },
      { "at": 220, "angle": 180, "width": 8 },
      { "at": 290, "period": 2.2, "phase": 0.5, "angle": 0, "width": 16, "height": 3 }
    ] },

    // Breathe, and hand back what the last stretch probably cost.
    { "length": 220, "pickups": [                                   // 1560 - 1780
      { "at": 110, "kind": "shield", "angle": 180 }
    ] },

    // A run of three in rhythm, all on the same cycle. Find the beat and they open like a door;
    // fight it and every one of them is shut.
    { "length": 420, "speed": 125, "turn": 35, "climb": 10, "obstacles": [   // 1780 - 2200
      { "at": 80, "period": 2.8, "angle": 0, "width": 22, "height": 3, "count": 3, "spacing": 120 }
    ] },

    // The same rhythm, but staggered, so holding one speed no longer works.
    { "length": 420, "turn": -45, "obstacles": [                    // 2200 - 2620
      { "at": 70,  "period": 2.8, "phase": 0,    "angle": 0,   "width": 22, "height": 3 },
      { "at": 190, "period": 2.8, "phase": 0.33, "angle": 120, "width": 22, "height": 3 },
      { "at": 310, "period": 2.8, "phase": 0.66, "angle": 240, "width": 22, "height": 3 }
    ] },

    { "length": 200, "section": "wide", "pickups": [                // 2620 - 2820
      { "at": 100, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 150, "kind": "target", "angle": 0, "count": 4, "angleStep": 90 }
    ] },

    // Run for home: gates on a twist, where the bend hides the cycle until you are on it.
    { "length": 180, "section": "tube", "turn": 65, "obstacles": [  // 2820 - 3000
      { "at": 100, "period": 2.4, "angle": 0, "width": 20, "height": 3 }
    ] },
    { "length": 180, "turn": -70, "climb": 12, "obstacles": [       // 3000 - 3180
      { "at": 90, "period": 2.4, "phase": 0.5, "angle": 180, "width": 20, "height": 3 }
    ] },
    { "length": 180, "turn": 60, "climb": -14, "obstacles": [       // 3180 - 3360
      { "at": 90, "period": 2.4, "angle": 90, "width": 18, "height": 3 }
    ] },

    // Handover to Metronome: straighten and blend into its tube, then the first 276 units of its
    // track, so the camera sees the same tube on both sides of the join. Nothing to hit out here; the
    // level finishes 16 units into this copy, which is where the next level places the ship.
    { "length": 120, "speed": 110, "section": "tube" },                           // 3360 - 3480
    { "length": 276 }                                               // 3480 - 3756
  ]
}
