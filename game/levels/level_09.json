{
  "name": "Neon Run",
  "speed": 100,
  "segmentLength": 60,

  "theme": {
    "darks": ["#0c0620", "#041421", "#140418"],
    "lights": ["#c02aa8", "#29b8cc", "#ccb029"],
    "seamDark": "#000000",
    "seamLight": "#ffffff",
    "far": "#000000",
    "ship": "#ffffff",
    "block": "#dfe6ff",
    "target": "#ff2050",
    "breakable": "#7cff9a",
    "fadeStart": 40,
    "fadeEnd": 360,
    "glow": 0.6
  },

  "sections": {
    "tube":     { "radius": 5.5 },
    "oval":     { "halfWidth": 9, "halfHeight": 4 },
    "box":      { "halfWidth": 9, "halfHeight": 4, "squareness": 1 },
    "flat":     { "radius": 5.5, "opening": 1 },
    "box-flat": { "halfWidth": 9, "halfHeight": 4, "squareness": 1, "opening": 1 },
    "tall-chamber": { "halfWidth": 6.5, "halfHeight": 13, "squareness": 0.6 }
  },

  // Obstacle "at" values are measured from the start of their piece.
  // The distances in the comments are for `play.ps1 -Start`.
  "start": "tube",
  "track": [
    { "length": 200 },                                              //    0 - 200
    { "length": 150, "turn": -50, "obstacles": [                    //  200 - 350
      { "at": 60, "angle": 0, "count": 4, "spacing": 50, "angleStep": 60 },
      { "at": 100, "kind": "target", "angle": 180, "count": 3, "spacing": 50 }
    ] },
    { "length": 150, "turn": 50, "climb": -12 },                    //  350 - 500

    // Flat: a gap, a jump to the ceiling, a zigzag up there, and a jump back.
    { "length": 100, "section": "flat", "speed": 125 },             //  500 - 600
    { "length": 500, "obstacles": [                                 //  600 - 1100
      { "at": 50, "x": -8, "width": 14 },
      { "at": 50, "x": 12, "width": 10 },
      { "at": 120, "width": 80, "height": 2.5 },
      { "at": 200, "surface": "ceiling", "x": 5, "width": 12, "count": 3, "spacing": 60, "xStep": -10 },
      { "at": 220, "kind": "target", "surface": "ceiling", "x": -12, "count": 3, "spacing": 60, "xStep": 12 },
      { "at": 420, "surface": "ceiling", "width": 80, "height": 2.5 },
      { "at": 460, "kind": "target" }
    ] },
    { "length": 360, "section": "tube" },                           // 1100 - 1460

    { "length": 100, "section": "oval", "turn": 20, "speed": 110 }, // 1460 - 1560
    { "length": 250, "turn": -60, "obstacles": [                    // 1560 - 1810
      { "at": 30, "angle": 60, "count": 4, "spacing": 55, "angleStep": -40 },
      { "at": 80, "kind": "target", "angle": 180, "count": 3, "spacing": 55 }
    ] },
    { "length": 100, "section": "tube", "turn": 20 },               // 1810 - 1910
    { "length": 200, "turn": 30, "climb": 20, "obstacles": [        // 1910 - 2110
      { "at": 30, "angle": 0, "count": 6, "spacing": 30, "angleStep": 60 }
    ] },

    { "length": 100, "section": "box", "speed": 125 },              // 2110 - 2210
    { "length": 200, "turn": -40, "obstacles": [                    // 2210 - 2410
      { "at": 30, "width": 6 },
      { "at": 90, "x": -6, "width": 6 },
      { "at": 90, "x": 6, "width": 6 },
      { "at": 150, "kind": "target", "angle": 90 },
      { "at": 150, "kind": "target", "angle": -90 }
    ] },
    { "length": 100, "section": "box-flat", "speed": 145 },         // 2410 - 2510
    { "length": 400, "obstacles": [                                 // 2510 - 2910
      { "at": 50, "x": -15, "width": 14, "count": 6, "spacing": 45, "xStep": 6 },
      { "at": 330, "width": 80, "height": 2.5 },
      { "at": 370, "kind": "target", "surface": "ceiling" }
    ] },
    { "length": 360, "section": "tube" },                           // 2910 - 3270

    { "length": 250, "turn": 60, "obstacles": [                     // 3270 - 3520
      { "at": 60, "kind": "target", "angle": 0, "count": 5, "spacing": 40, "angleStep": 72 }
    ] },

    // Stretch tall, fork over/under, merge, and narrow back down.
    { "length": 100, "section": "tall-chamber", "speed": 160, "obstacles": [  // 3520 - 3620
      { "at": 60, "angle": 180 }
    ] },
    { "length": 400, "split": {                                     // 3620 - 4020
        "section": "tube",
        "branches": [
          { "offsets": [[0, 0, -7], [120, 0, -20], [280, 0, -20], [400, 0, -7]] },
          { "offsets": [[0, 0, 7], [120, -6, 20], [280, 6, 20], [400, 0, 7]] }
        ]
      },
      "obstacles": [
        // A spiral of blocks below, targets above.
        { "at": 110, "branch": 0, "angle": 0, "count": 5, "spacing": 45, "angleStep": 72 },
        { "at": 130, "branch": 1, "kind": "target", "angle": 180, "count": 4, "spacing": 50 }
      ]
    },
    { "length": 100, "section": "tube" },                           // 4020 - 4120
    { "length": 200, "obstacles": [                                 // 4120 - 4320
      { "at": 110, "kind": "target" }
    ] }
  ]
}
