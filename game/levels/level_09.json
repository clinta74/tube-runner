{
  "name": "Loop the Loop",
  "id": "loop-the-loop",
  "next": "level_10.json",
  "speed": 110,
  "segmentLength": 60,

  // The first see-through level, early on purpose: a look at the wireframe style long before
  // Highwire builds a level around it. Loops and switchbacks on a single track, so the track bends
  // back on itself and every other part of it is in view through the wall.
  //
  // A loop flown at one steady rate closes into a circle and passes through its own entry. So every
  // loop here is built from pieces with different rates - a swing out and back over the top of a
  // vertical loop, a climb through a flat one - which carries the exit clear of the way in.
  // TrackClearanceTests checks that no part of the track comes within a tube's width of another.
  "theme": {
    "wire": true,
    "seamLight": "#7ff0ff",
    "far": "#000000",
    "ship": "#ffffff",
    "block": "#ff8a3a",
    "target": "#ff3a6a",
    "breakable": "#7cffb0",
    "fadeStart": 60,
    "fadeEnd": 700,
    "glow": 0.5
  },

  "sections": {
    "handover": { "radius": 5.5 },
    "tube": { "radius": 6 }
  },

  // Obstacle "at" values are measured from the start of their piece.
  // The distances in the comments are for `tube play --start`.
  "start": "tube",
  "track": [
    { "length": 260 },                                              //    0 -  260

    // A vertical loop. It swings right going up over the top and back left coming down, so the way
    // out runs beside the way in instead of through it, pointing the same way it came in.
    { "length": 160, "climb": 90, "pickups": [                      //  260 -  420
      { "at": 30, "kind": "shield", "angle": 180 }
    ] },
    { "length": 160, "climb": 90, "turn": 30, "obstacles": [        //  420 -  580
      { "at": 80, "kind": "target", "angle": 0 }
    ] },
    { "length": 160, "climb": 90, "turn": -30, "obstacles": [       //  580 -  740
      { "at": 80, "angle": 90, "width": 8 }
    ] },
    { "length": 160, "climb": 90, "obstacles": [                    //  740 -  900
      { "at": 70, "angle": -90, "width": 8 }
    ] },

    { "length": 220, "pickups": [                                   //  900 - 1120
      { "at": 40, "kind": "rapid-fire" }
    ], "obstacles": [
      { "at": 110, "kind": "target", "angle": 0, "count": 3, "spacing": 45, "angleStep": 120 }
    ] },

    // Switchbacks: a hairpin right, a straight back the way we came, a hairpin left. The legs run
    // side by side, so the next one is always in view through the wall.
    { "length": 300, "turn": 180, "obstacles": [                    // 1120 - 1420
      { "at": 150, "angle": 0, "width": 8 }
    ] },
    { "length": 220, "obstacles": [                                 // 1420 - 1640
      { "at": 60,  "angle": 0,   "width": 8 },
      { "at": 110, "kind": "target", "angle": 90, "count": 2, "angleStep": 180 },
      { "at": 160, "angle": 180, "width": 8 }
    ] },
    { "length": 300, "turn": -180, "obstacles": [                   // 1640 - 1940
      { "at": 100, "kind": "target", "angle": 180 },
      { "at": 200, "angle": 90, "width": 8 }
    ] },
    { "length": 220, "obstacles": [                                 // 1940 - 2160
      { "at": 60,  "kind": "target", "angle": 0, "count": 4, "angleStep": 90 },
      { "at": 150, "angle": 90, "count": 2, "spacing": 40, "angleStep": 180 }
    ] },
    { "length": 300, "turn": 180, "obstacles": [                    // 2160 - 2460
      { "at": 120, "angle": -90, "count": 2, "spacing": 60, "angleStep": 180, "width": 8 }
    ] },
    { "length": 200, "pickups": [                                   // 2460 - 2660
      { "at": 100, "kind": "ring-gun" }
    ] },

    // A flat loop that climbs as it goes round, so it passes over its own entry rather than through it.
    { "length": 320, "turn": 180, "climb": 30, "obstacles": [       // 2660 - 2980
      { "at": 90, "angle": 180, "width": 8 },
      { "at": 200, "kind": "target", "angle": 0, "count": 5, "angleStep": 72 }
    ] },
    { "length": 320, "turn": 180, "climb": -30, "obstacles": [      // 2980 - 3300
      { "at": 160, "angle": 90, "width": 8 }
    ] },

    { "length": 220, "pickups": [                                   // 3300 - 3520
      { "at": 110, "kind": "shield", "angle": 90 }
    ], "obstacles": [
      { "at": 40, "angle": 0, "width": 8 },
      { "at": 170, "angle": 180, "width": 8 }
    ] },

    // A dive loop, the other way up, swinging left and back over the bottom.
    { "length": 160, "climb": -90 },                                // 3520 - 3680
    { "length": 160, "climb": -90, "turn": -30, "obstacles": [      // 3680 - 3840
      { "at": 80, "kind": "target", "angle": 180 }
    ] },
    { "length": 160, "climb": -90, "turn": 30, "obstacles": [       // 3840 - 4000
      { "at": 80, "angle": 0, "width": 8 }
    ] },
    { "length": 160, "climb": -90 },                                // 4000 - 4160

    // Handover to Neon Run: straighten and blend into its tube, then the first 276 units of its
    // track, so the camera sees the same tube on both sides of the join. Nothing to hit out here; the
    // level finishes 16 units into this copy, which is where the next level places the ship.
    { "length": 120, "speed": 105, "section": "handover" },                       // 4160 - 4280
    { "length": 200 },                                              // 4280 - 4480
    { "length": 76, "turn": -25.333333 }                            // 4480 - 4556
  ]
}
