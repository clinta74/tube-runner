    { "length": 240, "section": "tube", "turn": 70, "obstacles": [  // 4940 - 5180
      { "at": 60, "kind": "target", "angle": 0, "group": "ic" }
    ], "apertures": [
      { "at": 190, "blades": 6, "open": 1, "keys": ["ic"] }
