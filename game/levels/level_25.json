    { "length": 240, "turn": -75, "climb": 12, "obstacles": [       // 5180 - 5420
      { "at": 60, "kind": "target", "angle": 180, "group": "id" }
    ], "apertures": [
      { "at": 190, "blades": 6, "open": 1, "angle": 180, "keys": ["id"] }
    ] },

    // Handover to Shutter: straighten and blend into its tube, then the first 276 units of its
