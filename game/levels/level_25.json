{
  "name": "Ransom",
  "id": "ransom",
  "next": "level_26.json",
  "speed": 155,
  "segmentLength": 60,

  // Tollgate's test. Nothing new: locked pads from 23, doors from 21, ordered groups from 13, forks
  // and wells from further back. What changes is that the locks now come with a bill attached.
  // Three things are stacked here that were kept apart before:
  //   - doors with three keys, spread far enough apart that they cannot be cleared in one sweep;
  //   - keys that are also ordered, so they will not break out of turn and the ring gun takes one
  //     member a shot rather than clearing the group;
  //   - a pad and a door on the same group, where the shot that opens the way also pays for it.
  // And the level charges for misses. A pad missed costs the prize; a door missed costs a shield;
  // the well down the quick branch costs the clock. Every lock here is worth something different,
  // which is the whole point of putting them in one level.
  "theme": {
    "darks": ["#2b1418", "#231014", "#351a1f"],
    "lights": ["#a8545f", "#8f4751", "#bd6470"],
    "seamDark": "#16080b",
    "seamLight": "#ffb3bd",
    "far": "#090304",
    "ship": "#ffb3bd",
    "block": "#e4c6ca",
    "target": "#ffe14a",
    "breakable": "#7cffb0",
    "fadeStart": 35,
    "fadeEnd": 345,
    "glow": 0.35
  },

  "sections": {
    "tube":         { "radius": 6 },
    "wide":         { "radius": 7.5 },
    "narrow":       { "radius": 5 },
    "oval":         { "halfWidth": 9, "halfHeight": 4.5 },
    "box":          { "halfWidth": 9.5, "halfHeight": 4.2, "squareness": 1 },
    "chamber":      { "halfWidth": 14, "halfHeight": 6.5, "squareness": 0.6 },
    "branch":       { "radius": 6 },
    "branch-tight": { "radius": 4.5 }
  },

  "start": "tube",
  "track": [
    { "length": 340, "pickups": [                                   //    0 -  340
      { "at": 300, "kind": "rapid-fire" }
    ] },

    // Three keys, one door. They are far enough apart around the tube that clearing them is a lap of
    // the wall, and the door is wide enough that arriving with one still standing is a wall.
    { "length": 740, "section": "wide", "obstacles": [              //  340 - 1080
      { "at": 100, "kind": "target", "angle": 45,   "group": "r1" },
      { "at": 270, "kind": "target", "angle": 165,  "group": "r1" },
      { "at": 440, "kind": "target", "angle": -75,  "group": "r1" },
      { "at": 620, "lockedBy": "r1", "angle": 0, "width": 28, "height": 3 }
    ] },

    // The same three keys, now ordered, so they have to be taken in turn: the one whose turn it is
    // burns bright and the rest sit dim. The pad behind the door is on the same group, so the last
    // shot opens the way and pays for it at once.
    { "length": 660, "section": "tube", "turn": -45, "obstacles": [ // 1080 - 1740
      { "at": 110, "kind": "target", "angle": 90,   "group": "r2", "order": 0 },
      { "at": 280, "kind": "target", "angle": -120, "group": "r2", "order": 1 },
      { "at": 370, "kind": "target", "angle": 180,  "group": "r2", "order": 2 },
      { "at": 510, "lockedBy": "r2", "angle": 0, "width": 26, "height": 3 }
    ], "pickups": [
      { "at": 570, "kind": "shield", "lockedBy": "r2" }
    ] },

    // A well between a key and the pad it lights. Both are up on the far side, and the well is high
    // on the wall where the curve turns it toward the ship, so it reads from a long way out - the
    // gamble is whether the prize is worth flying that line at all.
    { "length": 480, "section": "oval", "speed": 158, "obstacles": [ // 1740 - 2220
      { "at": 90, "kind": "target", "angle": 120, "group": "r3" }
    ], "warps": [
      { "at": 280, "angle": 150, "back": 200, "span": 0.24 }
    ], "pickups": [
      { "at": 400, "kind": "shield", "angle": 180, "lockedBy": "r3" }
    ] },

    // A fork where the quick road is shut. The key is in the chamber, so the choice is made with the
    // shot already taken or already missed - and the long way round is open either way.
    { "length": 160, "section": "chamber", "obstacles": [           // 2220 - 2380
      { "at": 70, "kind": "target", "angle": -90, "group": "rf" }
    ] },
    { "length": 440, "turn": 85, "split": {                         // 2380 - 2820
        "section": "branch",
        "branches": [
          { "offsets": [[0, -8, 0], [150, -32, 0], [290, -32, 0], [440, -8, 0]] },
          { "offsets": [[0, 8, 0], [150, 32, 0], [290, 32, 0], [440, 8, 0]], "section": "branch-tight" }
        ]
      },
      "obstacles": [
        { "at": 60,  "branch": 1, "lockedBy": "rf", "angle": 0, "width": 20, "height": 3 },
        { "at": 230, "branch": 1, "angle": 90, "width": 6 },
        { "at": 180, "branch": 0, "angle": 0, "count": 2, "spacing": 100, "angleStep": 120, "width": 7 }
      ],
      "pickups": [
        { "at": 330, "branch": 1, "kind": "shield" }
      ]
    },
    { "length": 140, "section": "tube" },                           // 2820 - 2960

    // Keys behind plates. The line the plates leave is not the line either key is on, so the shots
    // have to be taken from a place that is uncomfortable to hold.
    { "length": 580, "section": "box", "speed": 160, "obstacles": [ // 2960 - 3540
      { "at": 110, "kind": "plate", "angle": 60,  "width": 11, "height": 3 },
      { "at": 170, "kind": "target", "angle": 180, "group": "r4" },
      { "at": 240, "kind": "plate", "angle": -60, "width": 11, "height": 3 },
      { "at": 330, "kind": "target", "angle": 90,  "group": "r4" },
      { "at": 490, "lockedBy": "r4", "angle": 0, "width": 26, "height": 3 }
    ] },

    // Keys on movers, sliding while the shot is lined up, and a pad that is only worth the detour if
    // both land. Lead them.
    { "length": 560, "section": "tube", "turn": 50, "obstacles": [  // 3540 - 4100
      { "at": 120, "kind": "target", "sweep": 9,  "sweepTime": 3.0, "angle": 60,  "group": "r5" },
      { "at": 280, "kind": "target", "sweep": 9,  "sweepTime": 2.6, "angle": -60, "group": "r5" }
    ], "pickups": [
      { "at": 450, "kind": "ring-gun", "lockedBy": "r5" }
    ] },

    // Gates on the cycle with the key beyond them, and the door beyond that. Hurry or hold back; the
    // gap that lets the shot through is the same gap that lets the ship through.
    { "length": 500, "section": "narrow", "speed": 163, "obstacles": [ // 4100 - 4600
      { "at": 110, "period": 2.4, "angle": 0,   "width": 20, "height": 3 },
      { "at": 190, "period": 2.4, "phase": 0.5, "angle": 180, "width": 20, "height": 3 },
      { "at": 290, "kind": "target", "angle": 90, "group": "r6" },
      { "at": 430, "lockedBy": "r6", "angle": 0, "width": 22, "height": 3 }
    ] },

    { "length": 240, "section": "tube", "pickups": [                // 4600 - 4840
      { "at": 120, "kind": "shield", "angle": 90 }
    ] },

    // Run for home. A twist, and on each bend a key whose door is already round the corner: the shot
    // is taken on faith and the wall arrives before there is time to regret it.
    { "length": 220, "speed": 165, "turn": 75, "obstacles": [       // 4840 - 5060
      { "at": 60,  "kind": "target", "angle": 90, "group": "r7" },
      { "at": 170, "lockedBy": "r7", "angle": 0, "width": 22, "height": 3 }
    ] },
    { "length": 220, "turn": -80, "climb": 14, "obstacles": [       // 5060 - 5280
      { "at": 60,  "kind": "target", "angle": -90, "group": "r8" },
      { "at": 170, "lockedBy": "r8", "angle": 180, "width": 22, "height": 3 }
    ] },
    { "length": 220, "turn": 65, "climb": -12, "obstacles": [       // 5280 - 5500
      { "at": 60,  "kind": "target", "angle": 180, "group": "r9" },
      { "at": 170, "lockedBy": "r9", "angle": 90, "width": 22, "height": 3 }
    ] },

    // Handover to Iris: straighten and blend into its tube, then the first 276 units of its track, so
    // the camera sees the same tube on both sides of the join. Nothing to hit out here; the level
    // finishes 16 units into this copy, which is where the next level places the ship.
    { "length": 120, "section": "tube" },                           // 5500 - 5620
    { "length": 276 }                                               // 5620 - 5896
  ]
}
