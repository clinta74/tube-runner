{
  "name": "Iris",
  "id": "iris",
  "next": "level_26.json",
  "speed": 150,
  "segmentLength": 60,

  // The block's second idea: an aperture. A ring of blades that seals the tube and irises open as
  // its keys are shot, one blade's worth at a time.
  // It is the first lock in the game that opens by degrees. A door is open or shut; an aperture with
  // three keys is a tube with one side clear and the other walled, and which side that is depends on
  // which key the player got. So the question stops being "did the shot land" and becomes "which
  // shot, and where do I want to be when I arrive".
  // The level is slower than the two before it on purpose. A sealed ring costs a shield, and a ring
  // is read by counting blades, which takes a beat the run for home of a 165 level does not give.
  // Ordering, deliberately: a ring with a gap in it first, so the first aperture can be flown
  // through without a shot at all; then one key over the whole ring; then the ring divided; then the
  // rings that decide which way a fork can be taken.
  // The ring gun is held back until the aperture whose keys are ordered, where it costs a charge per
  // key instead of opening the ring outright. Handed out earlier it is a skeleton key.
  "theme": {
    "darks": ["#0d2426", "#0a1c1e", "#12302f"],
    "lights": ["#4f9e9b", "#428684", "#5fb3af"],
    "seamDark": "#04100f",
    "seamLight": "#a8fff4",
    "far": "#020808",
    "ship": "#a8fff4",
    "block": "#c4e8e4",
    "target": "#ffd23a",
    "breakable": "#7cffb0",
    "fadeStart": 35,
    "fadeEnd": 345,
    "glow": 0.4
  },

  "sections": {
    "tube":         { "radius": 6 },
    "wide":         { "radius": 7.5 },
    "oval":         { "halfWidth": 9, "halfHeight": 4.5 },
    "box":          { "halfWidth": 9.5, "halfHeight": 4.2, "squareness": 1 },
    "chamber":      { "halfWidth": 14, "halfHeight": 6.5, "squareness": 0.6 },
    "branch":       { "radius": 6 },
    "branch-tight": { "radius": 4.5 }
  },

  "start": "tube",
  "track": [
    { "length": 340, "pickups": [                                   //    0 -  340
      { "at": 300, "kind": "shield" }
    ] },

    // FREE LOOK. Eight blades with the two on the floor left out, so the ring can simply be flown
    // through on the line the ship is already holding. Its key is there to be shot by anyone who
    // wants the rest of the tube, and costs nothing to ignore.
    { "length": 500, "section": "wide", "obstacles": [              //  340 -  840
      { "at": 90, "kind": "target", "angle": 90, "group": "i1" }
    ], "apertures": [
      { "at": 340, "blades": 8, "open": 2, "keys": ["i1"] }
    ] },

    // The same ring with its gap turned onto the ceiling. Nothing has to be shot here either, but
    // the way through is no longer the way the ship was already going.
    { "length": 480, "section": "tube", "turn": 35, "obstacles": [  //  840 - 1320
      { "at": 90, "kind": "target", "angle": -90, "group": "i2" }
    ], "apertures": [
      { "at": 330, "blades": 8, "open": 2, "angle": 180, "keys": ["i2"] }
    ] },

    // The first sealed ring. One key over all six blades, a long way in front of it, on a straight
    // where the ring can be seen the whole time the shot is being lined up. Miss it and it is a wall.
    { "length": 520, "section": "wide", "obstacles": [              // 1320 - 1840
      { "at": 80, "kind": "target", "angle": 120, "group": "i3" }
    ], "apertures": [
      { "at": 380, "blades": 6, "keys": ["i3"] }
    ] },

    // A shield first, then a sealed ring on a bend, where the ring is not in sight until the shot
