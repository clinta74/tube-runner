{
  "name": "Earthworks",
  "next": "level_08.json",
  "speed": 80,
  "segmentLength": 60,

  "theme": {
    "darks": ["#3b2919", "#2e4a2b", "#4a4f24"],
    "lights": ["#b08c3d", "#7a592e", "#8c8a42"],
    "seamDark": "#1f140a",
    "seamLight": "#d9ad4d",
    "far": "#0d0a05",
    "ship": "#d9ad4d",
    "block": "#e8dfc8",
    "target": "#ff5a1f",
    "fadeStart": 30,
    "fadeEnd": 320,
    "glow": 0
  },

  "sections": {
    "tube": { "radius": 6 },
    "oval": { "halfWidth": 9, "halfHeight": 4.5 },
    "box":  { "halfWidth": 10, "halfHeight": 4.2, "squareness": 1 },
    "flat": { "radius": 6, "opening": 1 },
    "chamber": { "halfWidth": 14, "halfHeight": 6.5, "squareness": 0.6 },
    "branch-tight": { "radius": 4.5 }
  },

  // Obstacle "at" values are measured from the start of their piece.
  // The distances in the comments are for `play.ps1 -Start`.
  "start": "tube",
  "track": [
    { "length": 150 },                                              //    0 - 150

    // Warm-up: shoot a few targets, dodge a first block.
    { "length": 160, "turn": 40, "obstacles": [                     //  150 - 310
      { "at": 70, "kind": "target" },
      { "at": 110, "kind": "target", "x": -3 },
      { "at": 150, "kind": "target", "x": 3 }
    ] },
    { "length": 140, "turn": -60, "climb": 10, "obstacles": [       //  310 - 450
      { "at": 70 }
    ] },

    // Slalom around the oval.
    { "length": 80, "section": "oval", "turn": 15, "speed": 90, "obstacles": [   //  450 - 530
      { "at": 30, "angle": -40, "count": 3, "spacing": 120 }
    ] },
    { "length": 200, "turn": -30, "climb": -10, "pickups": [        //  530 - 730
      { "at": 100, "kind": "shield", "angle": 180 }
    ], "obstacles": [
      { "at": 10, "angle": 40, "count": 3, "spacing": 120 },
      { "at": 170, "kind": "target", "angle": 90 }
    ] },
    { "length": 80, "section": "tube", "obstacles": [               //  730 - 810
      { "at": 30, "kind": "target", "angle": -90 }
    ] },
    { "length": 120, "turn": 30, "obstacles": [                     //  810 - 930
      { "at": 10, "kind": "target", "angle": 180 }
    ] },

    // First flat section: unroll, run, then a long funnel back into the tube. Flat pieces are straight.
    { "length": 100, "section": "flat", "speed": 100 },             //  930 - 1030
    { "length": 400, "pickups": [                                   // 1030 - 1430
      { "at": 160, "kind": "shield" }
    ], "obstacles": [
      // A gap, targets out wide, then walls that force jumps.
      { "at": 50, "x": -6, "width": 8 },
      { "at": 50, "x": 8, "width": 6 },
      { "at": 130, "kind": "target", "x": -12 },
      { "at": 130, "kind": "target", "x": 12 },
      { "at": 220, "width": 80, "height": 2.5 },                          // jump to the ceiling
      { "at": 290, "surface": "ceiling", "width": 10 },
      { "at": 290, "kind": "target", "surface": "ceiling", "x": -10 },
      { "at": 370, "surface": "ceiling", "width": 80, "height": 2.5 }     // jump back down
    ] },
    { "length": 360, "section": "tube", "speed": 90 },              // 1430 - 1790

    // Spiral of blocks, then the box.
    { "length": 150, "turn": -45, "climb": 15, "pickups": [         // 1790 - 1940
      { "at": 15, "kind": "rapid-fire" }
    ], "obstacles": [
      { "at": 50, "angle": 0, "count": 4, "spacing": 45, "angleStep": 90 }
    ] },
    { "length": 100, "section": "box", "speed": 100, "pickups": [   // 1940 - 2040
      { "at": 50, "kind": "unstoppable" }
    ] },
    { "length": 250, "turn": 40, "obstacles": [                     // 2040 - 2290
      { "at": 50, "x": -5, "width": 10 },
      { "at": 120, "x": 5, "width": 10 },
      { "at": 190, "kind": "target" },
      { "at": 230, "kind": "target", "angle": 90 }
    ] },
    { "length": 100, "section": "tube" },                           // 2290 - 2390

    // A ring of targets with the floor left open, then a twist of blocks.
    { "length": 200, "turn": -20, "climb": -15, "pickups": [        // 2390 - 2590
      { "at": 15, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 50, "kind": "target", "angle": 90, "count": 3, "angleStep": 90 },
      { "at": 110, "angle": 180, "count": 3, "spacing": 25, "angleStep": 45 }
    ] },

    // Second flat section: a sweeping wall, targets, and one more jump.
    { "length": 100, "section": "flat", "speed": 115 },             // 2590 - 2690
    { "length": 350, "pickups": [                                   // 2690 - 3040
      { "at": 200, "kind": "shield", "x": -20 }
    ], "obstacles": [
      { "at": 50, "x": -10, "width": 12, "count": 5, "spacing": 50, "xStep": 5 },
      { "at": 80, "kind": "target", "x": 15, "count": 4, "spacing": 50, "xStep": -8 },
      { "at": 310, "width": 80, "height": 2.5 },
      { "at": 335, "kind": "target", "surface": "ceiling" }
    ] },
    { "length": 360, "section": "tube" },                           // 3040 - 3400

    // Widen into a chamber, fork left/right, merge, and narrow back down.
    { "length": 100, "section": "chamber", "speed": 125, "pickups": [    // 3400 - 3500
      { "at": 70, "kind": "full-shields" }
    ], "obstacles": [
      { "at": 40, "kind": "target" }
    ] },
    // The bend has to be hard for the inside line to be worth anything: the ground a branch saves is
    // roughly its offset times the turn in radians, so a gentle piece saves nothing whatever the
    // offsets. This was a 20 degree turn and the short way came out 0.9% shorter - a tenth of a
    // second, which no one would ever take a tighter tube for.
    { "length": 400, "turn": 75, "split": {                         // 3500 - 3900
        "section": "tube",
        "branches": [
          // The piece turns right, so the right branch runs round the inside: a shorter way to the
          // merge, in a tighter tube and packed with blocks. Left is the long way, roomy and clear.
          { "offsets": [[0, -7.5, 0], [120, -30, 0], [280, -30, 0], [400, -7.5, 0]] },
          { "offsets": [[0, 7.5, 0], [120, 30, 0], [280, 30, 0], [400, 7.5, 0]], "section": "branch-tight" }
        ]
      },
      "pickups": [
        // The block-heavy right branch pays out an extra shield slot.
        { "at": 220, "branch": 1, "kind": "shield-slot" }
      ],
      "obstacles": [
        // Targets down the left branch, blocks down the right.
        { "at": 100, "branch": 0, "kind": "target", "angle": 0, "count": 4, "spacing": 60, "angleStep": 90 },
        { "at": 130, "branch": 1, "angle": 0, "count": 4, "spacing": 50, "angleStep": 90 },
        { "at": 340, "branch": 1, "angle": 180, "count": 2, "spacing": 35 }
      ]
    },
    { "length": 100, "section": "tube" },                           // 3900 - 4000

    // Twisting finish: every bend hides what's behind it until you're on it.
    { "length": 150, "turn": 70, "obstacles": [                     // 4000 - 4150
      { "at": 90, "angle": 0, "count": 2, "spacing": 45, "angleStep": 90 }
    ] },
    { "length": 150, "turn": -75, "climb": 12, "obstacles": [       // 4150 - 4300
      { "at": 80, "kind": "target", "angle": 180 },
      { "at": 120, "angle": 90 }
    ] },
    { "length": 150, "turn": 65, "climb": -15, "obstacles": [       // 4300 - 4450
      { "at": 70, "angle": -90, "count": 3, "angleStep": 60 }
    ] },
    { "length": 200 }                                               // 4450 - 4650
  ]
}
