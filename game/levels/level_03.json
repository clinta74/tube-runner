{
  "name": "Throttle",
  "next": "level_04.json",
  "speed": 85,
  "segmentLength": 60,

  // Speed control: open road to push into, gauntlets to back off for.
  "theme": {
    "darks": ["#241515", "#2b1c10", "#161d24"],
    "lights": ["#d0643c", "#e0a24a", "#5f93b5"],
    "seamDark": "#120a08",
    "seamLight": "#ffd9a0",
    "far": "#08050a",
    "ship": "#ffd9a0",
    "block": "#cac4b2",
    "target": "#ff5a2a",
    "breakable": "#7fc7e8",
    "fadeStart": 30,
    "fadeEnd": 320,
    "glow": 0
  },

  "sections": {
    "handover": { "radius": 6 },
    "tube": { "radius": 6.5 },
    "oval": { "halfWidth": 9, "halfHeight": 5 }
  },

  "start": "tube",
  "track": [
    { "length": 200 },                                              //    0 -  200

    // Open road: nothing in the way, so wind the throttle up (W / up).
    { "length": 400, "speed": 115, "obstacles": [                   //  200 -  600
      { "at": 80, "kind": "target" },
      { "at": 200, "kind": "target", "angle": 120 },
      { "at": 320, "kind": "target", "angle": -120 }
    ] },

    // Gauntlet: a spiral to thread, and it comes at you fast unless you ease off (S / down).
    { "length": 250, "turn": 40, "speed": 85, "pickups": [          //  600 -  850
      { "at": 220, "kind": "shield", "angle": 180 }
    ], "obstacles": [
      { "at": 40, "angle": -50, "count": 5, "spacing": 40, "angleStep": 50 }
    ] },

    { "length": 150, "section": "oval", "speed": 95 },              //  850 - 1000
    { "length": 300, "turn": -35, "obstacles": [                    // 1000 - 1300
      { "at": 120, "hits": 1, "angle": 0, "count": 8, "angleStep": 45, "width": 5 },
      { "at": 240, "kind": "target", "angle": 0, "count": 3, "angleStep": 120 }
    ] },

    // Rapid fire before a run of tough blocks: shoot them out or swing around them.
    { "length": 150, "section": "tube", "speed": 105, "pickups": [  // 1300 - 1450
      { "at": 60, "kind": "rapid-fire" }
    ] },
    { "length": 400, "speed": 120, "obstacles": [                   // 1450 - 1850
      { "at": 40, "hits": 3, "count": 4, "spacing": 90 }
    ] },

    // Last gauntlet: a sealed ring of breakable blocks, with the ring gun just before it.
    { "length": 250, "turn": -30, "speed": 90, "pickups": [         // 1850 - 2100
      { "at": 30, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 120, "hits": 2, "angle": 0, "count": 8, "angleStep": 45, "width": 4.6 }
    ] },

    // Handover to Ovals: straighten and blend into its tube, then the first 276 units of its
    // track, so the camera sees the same tube on both sides of the join. Nothing to hit out here; the
    // level finishes 16 units into this copy, which is where the next level places the ship.
    { "length": 120, "section": "handover" },                       // 2100 - 2220
    { "length": 276 }                                               // 2220 - 2496
  ]
}
