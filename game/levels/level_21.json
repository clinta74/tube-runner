{
  "name": "Attrition",
  "next": "level_22.json",
  "speed": 145,
  "segmentLength": 60,

  // Block C's test, and the point where the scarcity curve starts to bite. Everything from C -
  // plates, keys and doors - over everything from A and B. One shield in the whole level, and it is
  // most of the way through, so the run arrives at block D on whatever it managed to keep.
  // The name is the design: nothing here is individually harder than what came before. It is long,
  // it is dense, and it does not give anything back.
  "theme": {
    "darks": ["#241a1a", "#1d1414", "#2c2020"],
    "lights": ["#9c7070", "#865e5e", "#ad8080"],
    "seamDark": "#120b0b",
    "seamLight": "#ffb3b3",
    "far": "#070404",
    "ship": "#ffb3b3",
    "block": "#d2b9b9",
    "target": "#ff4040",
    "breakable": "#ffd06b",
    "fadeStart": 35,
    "fadeEnd": 330,
    "glow": 0.3
  },

  "sections": {
    "tube":   { "radius": 6 },
    "narrow": { "radius": 4.5 },
    "box":    { "halfWidth": 9.5, "halfHeight": 4.2, "squareness": 1 },
    "flat":   { "radius": 6, "opening": 1 },
    "oval":   { "halfWidth": 9, "halfHeight": 4.5 }
  },

  "start": "tube",
  "track": [
    { "length": 180 },                                              //    0 -  180

    // No free look, no refill. Keys, doors and plates from the first bend.
    { "length": 420, "turn": 40, "warps": [                         //  180 -  600
      { "at": 260, "angle": -90 }
    ], "obstacles": [
      { "at": 90,  "kind": "target", "angle": 90, "group": "k1" },
      { "at": 200, "kind": "plate", "angle": 0, "width": 12, "height": 3 },
      { "at": 350, "lockedBy": "k1", "angle": 180, "width": 24, "height": 3 }
    ] },

    // Gates and plates on one stretch: one opens on a cycle and one never does, and telling them
    // apart at speed is the whole problem. They are deliberately the same size.
    { "length": 440, "section": "tube", "obstacles": [              //  600 - 1040
      { "at": 100, "period": 2.2, "angle": 0,   "width": 20, "height": 3 },
      { "at": 100, "kind": "plate", "angle": 180, "width": 12, "height": 3 },
      { "at": 250, "kind": "plate", "angle": 90,  "width": 12, "height": 3 },
      { "at": 250, "period": 2.2, "phase": 0.5, "angle": 270, "width": 20, "height": 3 },
      { "at": 380, "period": 2.2, "angle": 45,  "width": 20, "height": 3 }
    ] },

    // Held slow through a limit, with a key to shoot and its door waiting past the zone. The limit
    // gives time to aim, which is the only kindness in the level.
    { "length": 460, "section": "narrow", "speedLimits": [          // 1040 - 1500
      { "at": 200, "length": 300, "maxSpeed": 105 }
    ], "obstacles": [
      { "at": 140, "kind": "target", "angle": 180, "group": "k2" },
      { "at": 260, "sweep": 7, "sweepTime": 2.8, "width": 6, "angle": 0 },
      { "at": 400, "lockedBy": "k2", "angle": 90, "width": 20, "height": 3 }
    ] },

    // Rapid fire - a tool, not a gift, and the only one until the shield.
    { "length": 240, "section": "tube", "speed": 155, "pickups": [  // 1500 - 1740
      { "at": 120, "kind": "rapid-fire" }
    ] },

    // Flat, with plates that cannot be shot, gates that open, and a forced jump between them.
    { "length": 120, "section": "flat", "speed": 150 },             // 1740 - 1860
    { "length": 460, "obstacles": [                                 // 1860 - 2320
      { "at": 90,  "period": 2.2, "width": 80, "height": 2.5 },
      { "at": 200, "kind": "plate", "x": -14, "width": 26, "height": 2.5 },
      { "at": 200, "kind": "plate", "x": 16,  "width": 22, "height": 2.5 },
      { "at": 320, "width": 80, "height": 2.5 },
      { "at": 400, "kind": "plate", "surface": "ceiling", "x": -10, "width": 24, "height": 2.5 }
    ] },

    // The shield. Most of the way through, on the ceiling, off the fast line - it costs time to take
    // and the run needs it anyway.
    { "length": 260, "section": "tube", "speed": 155, "pickups": [  // 2320 - 2580
      { "at": 130, "kind": "shield", "angle": 180 }
    ] },

    // An ordered group that is also a key, with plates crowding the lines it can be shot from, at
    // the highest speed so far. Three mechanics on one stretch and no tool that shortcuts it.
    { "length": 480, "section": "box", "speed": 165, "obstacles": [ // 2580 - 3060
      { "at": 100, "kind": "plate", "angle": 45,  "width": 11, "height": 3 },
      { "at": 160, "kind": "target", "angle": 90,  "group": "k3", "order": 0 },
      { "at": 250, "kind": "plate", "angle": -45, "width": 11, "height": 3 },
      { "at": 310, "kind": "target", "angle": -90, "group": "k3", "order": 1 },
      { "at": 430, "lockedBy": "k3", "angle": 0, "width": 26, "height": 3 }
    ] },

    // A shoal in a limit: slow means more sweeps pass before arrival, the pairing from Undertow,
    // now with plates fixed among the movers so part of the wall never opens.
    { "length": 460, "section": "narrow", "turn": -45, "speedLimits": [  // 3060 - 3520
      { "at": 210, "length": 320, "maxSpeed": 100 }
    ], "obstacles": [
      { "at": 110, "sweep": 7, "sweepTime": 2.8, "width": 6, "angle": 0 },
      { "at": 220, "kind": "plate", "angle": 120, "width": 9, "height": 3 },
      { "at": 330, "sweep": 7, "sweepTime": 2.8, "width": 6, "angle": 240 }
    ] },

    // Run for home. A twist, at full speed, with a plate or a gate at every bend and nothing given.
    { "length": 200, "section": "tube", "speed": 170, "turn": 75, "obstacles": [   // 3520 - 3720
      { "at": 105, "kind": "plate", "angle": 0, "width": 12, "height": 3 }
    ] },
    { "length": 200, "turn": -80, "climb": 14, "obstacles": [       // 3720 - 3920
      { "at": 100, "period": 2.0, "angle": 180, "width": 20, "height": 3 }
    ] },
    { "length": 200, "turn": 70, "climb": -16, "obstacles": [       // 3920 - 4120
      { "at": 100, "kind": "plate", "angle": 90, "width": 12, "height": 3 }
    ] },
    { "length": 200, "turn": -65, "climb": 12, "obstacles": [       // 4120 - 4320
      { "at": 100, "sweep": 10, "sweepTime": 2.4, "width": 8, "angle": 0 }
    ] },

    { "length": 260 }                                               // 4320 - 4580
  ]
}
