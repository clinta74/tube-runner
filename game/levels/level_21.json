{
  "name": "Crossfire",
  "id": "crossfire",
  "next": "level_22.json",
  "speed": 140,
  "segmentLength": 60,
  "music": "pulse",

  // Plates and movers with a shooting load that will not wait. Unstoppable comes back here, one
  // level after plates were taught - so the player now knows there is one thing it cannot answer,
  // and the level is built around that knowledge: ram lanes that end in a plate, where the habit
  // of smashing through has to be broken mid-stretch.
  "theme": {
    "darks": ["#2e2016", "#261a12", "#38271b"],
    "lights": ["#b08a5c", "#98754d", "#c49a68"],
    "seamDark": "#170f08",
    "seamLight": "#ffd9a0",
    "far": "#0b0704",
    "ship": "#ffd9a0",
    "block": "#d6c3a8",
    "target": "#ff5a3a",
    "breakable": "#9adfff",
    "fadeStart": 35,
    "fadeEnd": 340,
    "glow": 0.3
  },

  "sections": {
    "tube": { "radius": 6 },
    "box":  { "halfWidth": 9.5, "halfHeight": 4.2, "squareness": 1 },
    "oval": { "halfWidth": 9, "halfHeight": 4.5 },
    "wide": { "radius": 7.5 }
  },

  "start": "tube",
  "track": [
    { "length": 200 },                                              //    0 -  200

    // Straight in: plates and movers together, so the unanswerable thing and the moving thing share
    // a stretch from the start.
    { "length": 380, "turn": 35, "obstacles": [                     //  200 -  580
      { "at": 100, "kind": "plate", "angle": 0, "width": 12, "height": 3 },
      { "at": 200, "sweep": 10, "sweepTime": 3.2, "width": 8, "angle": 150 },
      { "at": 310, "kind": "plate", "angle": 180, "width": 12, "height": 3 }
    ] },

    // Rapid fire before a wall of breakables with plates seeded through it. Shooting opens most of
    // it; which parts it cannot open is the read.
    { "length": 400, "section": "wide", "pickups": [                //  580 -  980
      { "at": 70, "kind": "rapid-fire" }
    ], "obstacles": [
      { "at": 180, "hits": 2, "angle": 0,   "width": 9 },
      { "at": 180, "kind": "plate", "angle": 90, "width": 11, "height": 3 },
      { "at": 180, "hits": 2, "angle": 180, "width": 9 },
      { "at": 300, "hits": 3, "angle": 270, "width": 9 },
      { "at": 300, "kind": "plate", "angle": 45, "width": 11, "height": 3 }
    ] },

    // THE RAM LANE. Unstoppable, then a corridor of blocks made to be smashed - with a plate at the
    // end of it. The habit has to break before the corridor does.
    { "length": 440, "section": "tube", "speed": 150, "pickups": [  //  980 - 1420
      { "at": 60, "kind": "unstoppable" }
    ], "obstacles": [
      { "at": 150, "angle": 0,   "width": 10 },
      { "at": 220, "angle": 90,  "width": 10 },
      { "at": 290, "angle": 180, "width": 10 },
      { "at": 360, "kind": "plate", "angle": 270, "width": 13, "height": 3 }
    ] },

    { "length": 240, "section": "oval", "pickups": [                // 1420 - 1660
      { "at": 120, "kind": "shield", "angle": 180 }
    ] },

    // Moving targets to shoot while plates crowd the line the shots have to be taken from. Shots fly
    // from wherever the ship sits, so the plates dictate where it can shoot from at all.
    { "length": 440, "section": "tube", "turn": -45, "obstacles": [ // 1660 - 2100
      { "at": 120, "kind": "plate", "angle": 90,  "width": 12, "height": 3 },
      { "at": 190, "kind": "target", "sweep": 8, "sweepTime": 3.0, "angle": 0 },
      { "at": 290, "kind": "plate", "angle": -90, "width": 12, "height": 3 },
      { "at": 360, "kind": "target", "sweep": 8, "sweepTime": 3.0, "angle": 180 }
    ] },

    // The box, at speed, with a shoal of movers and plates in the corners.
    { "length": 400, "section": "box", "speed": 160, "obstacles": [ // 2100 - 2500
      { "at": 90,  "kind": "plate", "angle": 0, "width": 13, "height": 3 },
      { "at": 190, "sweep": 12, "sweepTime": 3.0, "width": 8, "angle": 90, "count": 2, "spacing": 100, "angleStep": 180 },
      { "at": 340, "kind": "plate", "angle": 180, "width": 13, "height": 3 }
    ] },

    { "length": 260, "section": "wide", "speed": 150, "pickups": [  // 2500 - 2760
      { "at": 130, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 200, "kind": "target", "angle": 0, "count": 5, "angleStep": 72 }
    ] },

    // Ring gun against a mixed ring: it sweeps the targets and the breakables, and leaves every
    // plate standing. One button, and it only solves half the wall.
    { "length": 400, "section": "tube", "turn": 50, "obstacles": [  // 2760 - 3160
      { "at": 140, "kind": "target", "angle": 0, "count": 3, "angleStep": 60 },
      { "at": 140, "kind": "plate", "angle": 200, "width": 12, "height": 3 },
      { "at": 280, "hits": 2, "angle": 90, "width": 9 },
      { "at": 280, "kind": "plate", "angle": 270, "width": 12, "height": 3 }
    ] },

    { "length": 240, "speed": 155, "pickups": [                     // 3160 - 3400
      { "at": 120, "kind": "shield", "angle": 90 }
    ] },

    // Run for home: movers and plates at every bend of a twist.
    { "length": 200, "speed": 165, "turn": 75, "obstacles": [       // 3400 - 3600
      { "at": 105, "sweep": 10, "sweepTime": 2.5, "width": 8, "angle": 0 }
    ] },
    { "length": 200, "turn": -80, "climb": 14, "obstacles": [       // 3600 - 3800
      { "at": 100, "kind": "plate", "angle": 180, "width": 12, "height": 3 }
    ] },
    { "length": 200, "turn": 70, "climb": -16, "obstacles": [       // 3800 - 4000
      { "at": 100, "sweep": 10, "sweepTime": 2.5, "width": 8, "angle": 90 }
    ] },

    // Handover to Keys: straighten and blend into its tube, then the first 276 units of its
    // track, so the camera sees the same tube on both sides of the join. Nothing to hit out here; the
    // level finishes 16 units into this copy, which is where the next level places the ship.
    { "length": 120, "speed": 140, "section": "tube" },                           // 4000 - 4120
    { "length": 276 }                                               // 4120 - 4396
  ]
}
