{
  "name": "Restraint",
  "next": "level_16.json",
  "speed": 130,
  "segmentLength": 60,

  // Limits where the track most invites speed. Level 14 taught the zone; this one puts every zone
  // at the end of something that makes the player want to push - a long clear run, a wide bore, a
  // stretch they have just cleared and feel good about. The lesson is throttle discipline, and it
  // is deliberately uncomfortable: this is the only mechanic in the game that punishes the thing
  // the rest of it rewards.
  "theme": {
    "darks": ["#20281c", "#1a2117", "#283021"],
    "lights": ["#8fa878", "#7b9366", "#9db487"],
    "seamDark": "#0f130c",
    "seamLight": "#d4ff9f",
    "far": "#070a06",
    "ship": "#d4ff9f",
    "block": "#eef5e4",
    "target": "#ff7a3a",
    "breakable": "#ffe36b",
    "fadeStart": 35,
    "fadeEnd": 340,
    "glow": 0.25
  },

  "sections": {
    "tube":   { "radius": 6 },
    "narrow": { "radius": 4.5 },
    "oval":   { "halfWidth": 9, "halfHeight": 4.5 },
    "wide":   { "radius": 7.5 }
  },

  "start": "tube",
  "track": [
    { "length": 200 },                                              //    0 -  200

    // The widest bore in the level, wide open, fast. Everything about it says push.
    { "length": 400, "section": "wide", "speed": 155 },             //  200 -  600

    // And the limit lands the moment it closes. This is the shape the whole level repeats.
    { "length": 300, "section": "narrow", "speedLimits": [          //  600 -  900
      { "at": 150, "length": 220, "maxSpeed": 105 }
    ], "obstacles": [
      { "at": 100, "angle": 90,  "width": 7 },
      { "at": 200, "angle": -90, "width": 7 }
    ] },

    { "length": 260, "section": "tube", "speed": 140, "pickups": [  //  900 - 1160
      { "at": 130, "kind": "shield", "angle": 180 }
    ] },

    // A gauntlet cleared at speed, then immediately a limit. Clearing something well is exactly when
    // a player pushes hardest, so this is where the cost lands.
    { "length": 340, "speed": 150, "turn": -40, "obstacles": [      // 1160 - 1500
      { "at": 60, "angle": 0, "count": 5, "spacing": 55, "angleStep": 72 }
    ] },
    { "length": 300, "section": "narrow", "turn": -30, "speedLimits": [  // 1500 - 1800
      { "at": 150, "length": 230, "maxSpeed": 100 }
    ] },

    // Gates inside a limit. The gate wants the throttle used as timing; the limit caps how much of
    // it there is to use. Hurrying into an open gate can cost a shield to the zone instead.
    { "length": 360, "section": "tube", "speed": 145, "pickups": [  // 1800 - 2160
      { "at": 70, "kind": "rapid-fire" }
    ], "speedLimits": [
      { "at": 200, "length": 260, "maxSpeed": 115 }
    ], "obstacles": [
      { "at": 140, "period": 2.4, "angle": 0,   "width": 20, "height": 3 },
      { "at": 250, "period": 2.4, "phase": 0.5, "angle": 180, "width": 20, "height": 3 }
    ] },

    { "length": 240, "section": "oval", "speed": 150, "pickups": [  // 2160 - 2400
      { "at": 120, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 180, "kind": "target", "angle": 0, "count": 5, "angleStep": 72 }
    ] },

    // The longest straight in the level, at its highest speed. Then the tightest limit.
    { "length": 460, "section": "tube", "speed": 165 },             // 2400 - 2860
    { "length": 340, "section": "narrow", "turn": 65, "speedLimits": [   // 2860 - 3200
      { "at": 170, "length": 260, "maxSpeed": 95 }
    ], "obstacles": [
      { "at": 120, "angle": 180, "width": 7 },
      { "at": 240, "angle": 0,   "width": 7 }
    ] },

    { "length": 240, "section": "tube", "speed": 150, "pickups": [  // 3200 - 3440
      { "at": 120, "kind": "shield", "angle": 90 }
    ] },

    // Run for home through a twist, no limits: the restraint is over, spend everything.
    { "length": 190, "speed": 165, "turn": 75, "obstacles": [       // 3440 - 3630
      { "at": 100, "angle": 0, "count": 2, "spacing": 45, "angleStep": 120 }
    ] },
    { "length": 190, "turn": -80, "climb": 14, "obstacles": [       // 3630 - 3820
      { "at": 95, "kind": "target", "angle": 180 }
    ] },
    { "length": 190, "turn": 70, "climb": -16, "obstacles": [       // 3820 - 4010
      { "at": 95, "angle": 90, "count": 3, "angleStep": 60 }
    ] },
    { "length": 250 }                                               // 4010 - 4260
  ]
}
