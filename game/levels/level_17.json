{
  "name": "Undertow",
  "next": "level_18.json",
  "speed": 135,
  "segmentLength": 60,

  // Block B's test. Limits from 14 and 15, movers from 16, gates from 10, all together. The pairing
  // that makes this level its own thing is limits against movers: a mover's sweep is timed in
  // seconds, so being held slow inside a zone changes how many sweeps happen before the ship
  // arrives. The same shoal is a different problem at 100 u/s than at 150.
  "theme": {
    "darks": ["#152430", "#111d28", "#1b2b38"],
    "lights": ["#6d94ad", "#5c8099", "#7fa3ba"],
    "seamDark": "#081219",
    "seamLight": "#8fe0ff",
    "far": "#04090e",
    "ship": "#8fe0ff",
    "block": "#b9cfe0",
    "target": "#ff5f8a",
    "breakable": "#7cffd4",
    "fadeStart": 35,
    "fadeEnd": 345,
    "glow": 0.3
  },

  "sections": {
    "tube":   { "radius": 6 },
    "narrow": { "radius": 4.5 },
    "flat":   { "radius": 6, "opening": 1 },
    "oval":   { "halfWidth": 9, "halfHeight": 4.5 },
    "wide":   { "radius": 7.5 },
    "chamber":      { "halfWidth": 14, "halfHeight": 6.5, "squareness": 0.6 },
    "branch":       { "radius": 6 },
    "branch-tight": { "radius": 4.5 }
  },

  "start": "tube",
  "track": [
    { "length": 180 },                                              //    0 -  180

    // Straight in: movers and gates on the same stretch, no free look.
    { "length": 380, "turn": 35, "obstacles": [                     //  180 -  560
      { "at": 90,  "period": 2.3, "angle": 0, "width": 20, "height": 3 },
      { "at": 190, "sweep": 10, "sweepTime": 3.2, "width": 8, "angle": 120 },
      { "at": 300, "period": 2.3, "phase": 0.5, "angle": 180, "width": 20, "height": 3 }
    ] },

    // The level's own idea: a limit holding the ship slow through a shoal. Slow means more sweeps
    // pass before arrival, so the pattern that would have been threaded at speed has moved on.
    { "length": 420, "section": "narrow", "thrustZones": [          //  560 -  980
      { "at": 210, "length": 420 }
    ], "obstacles": [
      { "at": 110, "sweep": 7, "sweepTime": 3.0, "width": 6, "angle": 0 },
      { "at": 230, "sweep": 7, "sweepTime": 3.0, "width": 6, "angle": 120 },
      { "at": 340, "sweep": 7, "sweepTime": 3.0, "width": 6, "angle": 240 }
    ] },

    { "length": 260, "section": "wide", "speed": 150, "pickups": [  //  980 - 1240
      { "at": 130, "kind": "rapid-fire" }
    ], "obstacles": [
      { "at": 200, "kind": "target", "angle": 90 }
    ] },

    // Flat, with gates on both surfaces and a mover on each. On flat the sweep runs across the
    // plane rather than round a wall, so the same mechanic reads completely differently.
    { "length": 120, "section": "flat", "speed": 145 },             // 1240 - 1360
    { "length": 440, "obstacles": [                                 // 1360 - 1800
      { "at": 90,  "period": 2.2, "width": 80, "height": 2.5 },
      { "at": 200, "sweep": 16, "sweepTime": 3.4, "width": 12 },
      { "at": 200, "sweep": 16, "sweepTime": 3.4, "surface": "ceiling", "width": 12 },
      { "at": 330, "period": 2.2, "phase": 0.5, "surface": "ceiling", "width": 80, "height": 2.5 },
      { "at": 400, "kind": "target", "x": 12 }
    ] },

    // Breathe, and the only full refill in the level.
    { "length": 280, "section": "tube", "speed": 145, "pickups": [  // 1800 - 2080
      { "at": 140, "kind": "shield", "angle": 180 }
    ] },

    // Ordered group inside a limit: held slow, with targets to clear in sequence and a mover
    // crossing the line each shot has to take.
    { "length": 420, "section": "narrow", "turn": -40, "thrustZones": [  // 2080 - 2500
      { "at": 210, "length": 420 }
    ], "obstacles": [
      { "at": 120, "kind": "target", "angle": 90,  "group": "a", "order": 0 },
      { "at": 220, "sweep": 7, "sweepTime": 2.8, "width": 6, "angle": 0 },
      { "at": 300, "kind": "target", "angle": -90, "group": "a", "order": 1 },
      { "at": 380, "kind": "target", "angle": 180, "group": "a", "order": 2 }
    ] },

    { "length": 240, "section": "oval", "speed": 155, "pickups": [  // 2500 - 2740
      { "at": 120, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 180, "kind": "target", "angle": 0, "count": 5, "angleStep": 72 }
    ] },

    // The block's test gets a fork too, with a mover down the short road and a well down it as well
    // - the first time a branch carries one, five levels before Roulette makes a level of the idea.
    { "length": 140, "section": "chamber", "speed": 160 },          // 2740 - 2880
    { "length": 440, "turn": -85, "split": {                        // 2880 - 3320
        "section": "branch",
        "branches": [
          { "offsets": [[0, -8, 0], [150, -32, 0], [290, -32, 0], [440, -8, 0]], "section": "branch-tight" },
          { "offsets": [[0, 8, 0], [150, 32, 0], [290, 32, 0], [440, 8, 0]] }
        ]
      },
      "warps": [
        { "at": 300, "branch": 0, "angle": -90 }
      ],
      "obstacles": [
        { "at": 150, "branch": 0, "sweep": 7, "sweepTime": 2.8, "width": 6, "angle": 0 },
        { "at": 220, "branch": 1, "kind": "target", "angle": 180 }
      ]
    },
    { "length": 140, "section": "tube" },                           // 3320 - 3460

    // Fast straight into a blind limited bend, the trap from 14 and 15, with a mover waiting in it.
    { "length": 380, "section": "tube", "speed": 165 },             // 2740 - 3120
    { "length": 320, "section": "narrow", "turn": 70, "thrustZones": [   // 3120 - 3440
      { "at": 160, "length": 320 }
    ], "obstacles": [
      { "at": 200, "sweep": 7, "sweepTime": 2.6, "width": 6, "angle": 180 }
    ] },

    { "length": 220, "section": "tube", "speed": 150, "pickups": [  // 3440 - 3660
      { "at": 110, "kind": "shield", "angle": 90 }
    ] },

    // Run for home: a twist with a gate, a mover and a fixed block at each bend. No limits - the
    // level stops asking for restraint exactly when there is no track left to spend it on.
    { "length": 200, "speed": 165, "turn": 75, "obstacles": [       // 3660 - 3860
      { "at": 105, "period": 2.0, "angle": 0, "width": 20, "height": 3 }
    ] },
    { "length": 200, "turn": -80, "climb": 14, "obstacles": [       // 3860 - 4060
      { "at": 100, "sweep": 10, "sweepTime": 2.4, "width": 8, "angle": 180 }
    ] },
    { "length": 200, "turn": 70, "climb": -16, "obstacles": [       // 4060 - 4260
      { "at": 100, "angle": 90, "count": 3, "angleStep": 60 }
    ] },

    { "length": 260 }                                               // 4260 - 4520
  ]
}
