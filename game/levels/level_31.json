      { "at": 120, "kind": "target", "angle": 90,  "group": "a", "order": 0 },
      { "at": 230, "sweep": 9, "sweepTime": 2.8, "width": 8, "angle": 0 },
      { "at": 330, "kind": "target", "angle": -90, "group": "a", "order": 1 },
      { "at": 420, "kind": "target", "angle": 180, "group": "a", "order": 2 }
    ] },

    // The box, dense, no tools.
    { "length": 420, "section": "box", "speed": 175, "obstacles": [ // 3560 - 3980
      { "at": 90,  "kind": "plate", "angle": 0, "width": 13, "height": 3 },
