    { "length": 560, "section": "oval", "obstacles": [              // 3980 - 4540
      { "at": 80,  "kind": "target", "angle": 30,   "group": "lk1" },
      { "at": 160, "kind": "target", "angle": 150,  "group": "lk2" },
      { "at": 240, "kind": "target", "angle": -90,  "group": "lk3" }
    ], "apertures": [
      { "at": 400, "blades": 6, "angle": 30, "keys": ["lk1", "lk2", "lk3"] }
    ], "pickups": [
      { "at": 300, "kind": "unstoppable", "angle": 0 },
      { "at": 500, "kind": "shield-slot", "angle": 30, "lockedBy": "lk1" }
    ] },

    // A limit right where the level most invites a push for the end.
    { "length": 400, "section": "narrow", "turn": 60, "thrustZones": [ // 4540 - 4940
      { "at": 200, "length": 400 }
    ], "obstacles": [
      { "at": 130, "kind": "plate", "angle": 90, "width": 9, "height": 3 },
      { "at": 290, "sweep": 7, "sweepTime": 2.6, "width": 6, "angle": 0 }
    ] },

    // Agility with the ring gun, for the wells and the twist at 175 and 180 that follow.
    { "length": 240, "section": "tube", "speed": 170, "pickups": [  // 4940 - 5180
      { "at": 60, "kind": "agility" },
      { "at": 120, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 180, "kind": "target", "angle": 0, "count": 5, "angleStep": 72 }
    ] },

    // Wells on the run in, on the fast line, from Highwire.
    { "length": 400, "section": "narrow", "speed": 175, "turn": -70, "warps": [ // 5180 - 5580
      { "at": 140, "angle": 90 },
      { "at": 310, "angle": -90 }
    ] },

    // Run for home: a long twist, one thing per bend, nothing given.
    { "length": 190, "section": "tube", "speed": 180, "turn": 80, "obstacles": [ // 5580 - 5770
      { "at": 100, "kind": "plate", "angle": 0, "width": 12, "height": 3 }
    ] },
    { "length": 190, "turn": -85, "climb": 14, "obstacles": [       // 5770 - 5960
      { "at": 95, "period": 2.0, "angle": 180, "width": 20, "height": 3 }
    ] },
    { "length": 190, "turn": 75, "climb": -16, "obstacles": [       // 5960 - 6150
      { "at": 95, "sweep": 10, "sweepTime": 2.4, "width": 8, "angle": 90 }
    ] },
    { "length": 190, "turn": -80, "climb": 12, "obstacles": [       // 6150 - 6340
      { "at": 95, "kind": "plate", "angle": 0, "width": 12, "height": 3 }
    ] },

    // Handover to Finale: straighten and blend into its tube, then the first 276 units of its
    // track, so the camera sees the same tube on both sides of the join. Nothing to hit out here; the
    // level finishes 16 units into this copy, which is where the next level places the ship.
    { "length": 120, "section": "tube" },                           // 6340 - 6460
    { "length": 160 },                                              // 6460 - 6620
    { "length": 116, "turn": 11.047619 }                            // 6620 - 6736
  ]
