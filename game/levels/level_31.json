{
  "name": "Long Odds",
  "id": "long-odds",
  "next": "level_32.json",
  "speed": 155,
  "segmentLength": 60,

  // The longest level in the game, and the one that gives least. Block D's test, and the last thing
  // before the finale, so what it really measures is how much the run has left.
  // Endurance rather than spikes: no single stretch here is the hardest in the game, but there are
  // more of them in a row than anywhere else, and the only refill is past the midpoint and off the
  // fast line. A level that takes two shields is far worse than it looks on its own, because the
  // finale comes next and nothing between them hands anything back.
  "theme": {
    "darks": ["#241a1a", "#1d1414", "#2c2020"],
    "lights": ["#9c7070", "#865e5e", "#ad8080"],
    "seamDark": "#120b0b",
    "seamLight": "#ffb3b3",
    "far": "#070404",
    "ship": "#ffb3b3",
    "block": "#d2b9b9",
    "target": "#ff4040",
    "breakable": "#ffd06b",
    "fadeStart": 30,
    "fadeEnd": 300,
    "glow": 0.3
  },

  "sections": {
    "tube":         { "radius": 6 },
    "narrow":       { "radius": 4.8 },
    "flat":         { "radius": 6, "opening": 1 },
    "oval":         { "halfWidth": 9, "halfHeight": 4.5 },
    "box":          { "halfWidth": 9.5, "halfHeight": 4.2, "squareness": 1 },
    "chamber":      { "halfWidth": 14, "halfHeight": 6.5, "squareness": 0.6 },
    "branch":       { "radius": 6 },
    "branch-tight": { "radius": 4.5 }
  },

  "start": "tube",
  "track": [
    { "length": 200 },                                              //    0 -  200

    // Gates and blocks, straight in.
    { "length": 400, "turn": 40, "obstacles": [                     //  200 -  600
      { "at": 90,  "period": 2.2, "angle": 0, "width": 20, "height": 3 },
      { "at": 200, "angle": 120, "width": 9 },
      { "at": 310, "period": 2.2, "phase": 0.5, "angle": 180, "width": 20, "height": 3 }
    ] },

    // A limit with movers in it.
    { "length": 440, "section": "narrow", "thrustZones": [          //  600 - 1040
      { "at": 220, "length": 440 }
    ], "obstacles": [
      { "at": 120, "sweep": 7, "sweepTime": 2.8, "width": 6, "angle": 0 },
      { "at": 250, "sweep": 7, "sweepTime": 2.8, "width": 6, "angle": 120 },
      { "at": 370, "kind": "plate", "angle": 240, "width": 9, "height": 3 }
    ] },

    // Keys and doors, with plates crowding the firing line.
    { "length": 460, "section": "tube", "speed": 165, "pickups": [  // 1040 - 1500
      { "at": 60, "kind": "rapid-fire" }
    ], "obstacles": [
      { "at": 140, "kind": "plate", "angle": 45, "width": 11, "height": 3 },
      { "at": 200, "kind": "target", "angle": 180, "group": "k1" },
      { "at": 390, "lockedBy": "k1", "angle": 0, "width": 24, "height": 3 }
    ] },

    // Flat, with the jump rhythm and plates that cannot be shot.
    { "length": 120, "section": "flat", "speed": 160 },             // 1500 - 1620
    { "length": 460, "obstacles": [                                 // 1620 - 2080
      { "at": 90,  "period": 2.2, "width": 80, "height": 2.5 },
      { "at": 90,  "period": 2.2, "phase": 0.5, "surface": "ceiling", "width": 80, "height": 2.5 },
      { "at": 220, "kind": "plate", "x": -14, "width": 26, "height": 2.5 },
      { "at": 330, "width": 80, "height": 2.5 },
      { "at": 420, "kind": "target", "surface": "ceiling", "x": 12 }
    ] },

    // A fork with a well down the quick branch, from Roulette.
    { "length": 140, "section": "chamber", "speed": 165 },          // 2080 - 2220
    { "length": 460, "turn": 95, "split": {                         // 2220 - 2680
        "section": "branch",
        "branches": [
          { "offsets": [[0, -8, 0], [155, -34, 0], [300, -34, 0], [460, -8, 0]] },
          { "offsets": [[0, 8, 0], [155, 34, 0], [300, 34, 0], [460, 8, 0]], "section": "branch-tight" }
        ]
      },
      "warps": [
        { "at": 300, "branch": 1, "angle": 90 }
      ],
      "pickups": [
