    { "length": 680, "section": "oval", "obstacles": [              // 4460 - 5140
      { "at": 170, "kind": "target", "angle": 150, "group": "s8" },
      { "at": 430, "kind": "target", "angle": -150, "group": "sc" },
      { "at": 500, "kind": "plate", "angle": 90, "width": 12, "height": 3 }
    ], "pickups": [
      { "at": 60, "kind": "unstoppable" }
