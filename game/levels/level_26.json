    { "length": 520, "section": "box", "obstacles": [               // 1940 - 2460
      { "at": 110, "kind": "plate", "angle": 45,  "width": 12, "height": 3 },
      { "at": 190, "kind": "target", "angle": 180, "group": "s4" },
      { "at": 260, "kind": "plate", "angle": -45, "width": 12, "height": 3 }
    ], "apertures": [
      { "at": 400, "blades": 6, "open": 1, "angle": 180, "keys": ["s4"] }
