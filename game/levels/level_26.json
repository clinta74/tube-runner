        ]
      },
      "apertures": [
        { "at": 20, "branch": 1, "blades": 6, "keys": ["sf"] }
      ],
      "obstacles": [
        { "at": 200, "branch": 0, "angle": 0, "count": 2, "spacing": 110, "angleStep": 120, "width": 7 },
        { "at": 260, "branch": 1, "sweep": 7, "sweepTime": 2.6, "angle": 90, "width": 6 }
