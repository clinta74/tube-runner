    { "length": 240, "speed": 170, "section": "tube", "turn": 75, "obstacles": [ // 5140 - 5380
      { "at": 60, "kind": "target", "angle": 0, "group": "s9" }
    ], "apertures": [
      { "at": 190, "blades": 6, "open": 1, "keys": ["s9"] }
