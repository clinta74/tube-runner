  // The block's test, and the fourth level of it, so resources are thin and nothing here is a free
  // look. Rings arrive with everything else the game has: keys that slide, keys behind gates, keys
  // flanked by plates, rings on bends that are not in sight until the shot has to be taken.
  // Two kinds of pressure the earlier levels kept off an aperture, both here:
  //   - a ring at the end of a long clear straight, which is the one place the throttle will already
  //     be wound up. The shot is the same shot; the time to take it is a third of what it was.
  //   - a ring divided three ways where only one quarter of it leads anywhere, so opening the wrong
  //     side is worse than opening nothing, because it costs the shot and still ends at a wall.
  // Unstoppable is the level's one mercy, and it is placed where it answers a ring rather than a
  // block: blades break like anything else under it, which is the last thing the block has to say
  // about locks - that the game's biggest hammer is still an answer, and a plate still is not.
  "theme": {
    "darks": ["#191b22", "#14161c", "#1f222b"],
    "lights": ["#6d7590", "#5c637b", "#7f88a5"],
    "seamDark": "#0a0b0e",
    "seamLight": "#cfe0ff",
    "far": "#040508",
    "ship": "#cfe0ff",
    "block": "#d8dde8",
    "target": "#ffd23a",
    "breakable": "#7cffb0",
    "fadeStart": 35,
    "fadeEnd": 345,
    "glow": 0.3
  },

  "sections": {
    "tube":         { "radius": 6 },
    "wide":         { "radius": 7.5 },
    "narrow":       { "radius": 5 },
    "oval":         { "halfWidth": 9, "halfHeight": 4.5 },
    "box":          { "halfWidth": 9.5, "halfHeight": 4.2, "squareness": 1 },
    "chamber":      { "halfWidth": 14, "halfHeight": 6.5, "squareness": 0.6 },
    "branch":       { "radius": 6 },
    "branch-tight": { "radius": 4.5 }
  },

  "start": "tube",
  "track": [
    // One shield, and it is all the level gives away for the next two thousand units.
    { "length": 340, "pickups": [                                   //    0 -  340
      { "at": 300, "kind": "shield" }
    ] },

    // A key on a mover, sliding while the shot is lined up, and its ring close enough behind that a
    // missed first shot is felt rather than merely noted.
    { "length": 480, "section": "wide", "obstacles": [              //  340 -  820
      { "at": 100, "kind": "target", "sweep": 10, "sweepTime": 3.0, "angle": 0, "group": "s1" }
    ], "apertures": [
      { "at": 330, "blades": 6, "keys": ["s1"] }
    ] },

    // A gate in front of the key: the shot only passes on the half of the cycle the gate is down for,
    // and the ring behind does not wait.
    { "length": 500, "section": "tube", "turn": -45, "obstacles": [ //  820 - 1320
      { "at": 110, "period": 2.2, "angle": 0, "width": 22, "height": 3 },
      { "at": 200, "kind": "target", "angle": 0, "group": "s2" }
    ], "apertures": [
      { "at": 380, "blades": 6, "keys": ["s2"] }
    ] },

    // The long clear straight, and the ring at the end of it. Nothing is in the way, which is the
    // trap: the throttle goes up because there is no reason for it not to, and then there is.
    { "length": 620, "section": "wide", "speed": 164, "obstacles": [ // 1320 - 1940
      { "at": 430, "kind": "target", "angle": 90, "group": "s3" }
    ], "apertures": [
      { "at": 560, "blades": 6, "keys": ["s3"] }
    ] },

    // Plates either side of the key, so the shot has to be taken from a line that is already the
