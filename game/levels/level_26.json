    { "length": 240, "turn": 65, "climb": -12, "obstacles": [       // 5620 - 5860
      { "at": 60, "kind": "target", "angle": 90, "group": "sb" }
    ], "apertures": [
      { "at": 190, "blades": 6, "open": 1, "angle": 90, "keys": ["sb"] }
    ] },

    // Handover to Roulette: straighten and blend into its tube, then the first 276 units of its
