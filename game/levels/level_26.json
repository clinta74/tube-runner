    { "length": 760, "section": "wide", "speed": 166, "obstacles": [ // 3480 - 4240
      { "at": 90,  "kind": "target", "angle": 30,   "group": "s5" },
      { "at": 270, "kind": "target", "angle": 150,  "group": "s6" },
      { "at": 450, "kind": "target", "angle": -90,  "group": "s7" }
    ], "apertures": [
      { "at": 620, "blades": 6, "angle": 30, "keys": ["s5", "s6", "s7"] }
