{
  "name": "Ring Bench",
  "id": "bench-ring",
  "speed": 90,
  "segmentLength": 60,

  // A bench for the ring: a bore wide enough that only part of the way round it is on screen, with
  // a second cylinder down the middle. The ship flies in the gap between them, and the jump crosses
  // it - outer wall underfoot, core overhead, exactly the relationship a flat section's floor and
  // ceiling have.
  // A section says how much room its ring leaves ('ringHeight'), not how big the core is, and the
  // most it may leave is 70% of the bore - so a taller ring is bought by widening the tube. At
  // radius 22 that ceiling is 15.4, and the three rings below run from most of it down to a squeeze.
  "theme": {
    "darks": ["#1a1d26", "#15171f", "#20242f"],
    "lights": ["#6f7a9c", "#5e6786", "#828db2"],
    "seamDark": "#0a0c10",
    "seamLight": "#cfe4ff",
    "far": "#04050a",
    "ship": "#cfe4ff",
    "block": "#dce3f0",
    "target": "#ffd23a",
    "breakable": "#7cffb0",
    "fadeStart": 60,
    "fadeEnd": 400,
    "glow": 0.35
  },

  "sections": {
    "tube":       { "radius": 6 },
    "mouth":      { "radius": 22 },
    "ring-tall":  { "radius": 22, "ringHeight": 13 },
    "ring":       { "radius": 22, "ringHeight": 9 },
    "ring-tight": { "radius": 22, "ringHeight": 5 },
    "ring-box":   { "halfWidth": 24, "halfHeight": 18, "squareness": 0.7, "ringHeight": 10 }
  },

  "start": "tube",
  "track": [
    // Open out into the wide bore first, so the core is not the thing that arrives.
    { "length": 260 },                                              //    0 -  260
    { "length": 380, "section": "mouth" },                          //  260 -  640

    // The core grows in over one piece. Nothing to hit while the shape is changing, and the blend is
    // kept short: a core has to pass through nothing at all on its way in, and the shorter the blend
    // the less of the bore is spent with a needle down the middle of it.
    { "length": 180, "section": "ring-tall" },                      //  640 -  820

    // A tall ring: the most room this bore will give. Blocks on both walls - the ones overhead can
    // only be met by jumping up to the core, and the ones underfoot by coming back down.
    { "length": 700, "obstacles": [                                 //  820 - 1520
      { "at": 130, "angle": 0, "width": 8 },
      { "at": 270, "surface": "ceiling", "angle": 0, "width": 8 },
      { "at": 410, "angle": 60, "width": 8 },
      { "at": 550, "surface": "ceiling", "angle": -60, "width": 8 }
    ] },

    // Targets right round the core, to see how much of it is on screen at once.
    { "length": 560, "obstacles": [                                 // 1520 - 2080
      { "at": 100, "kind": "target", "surface": "ceiling", "angle": 0 },
      { "at": 200, "kind": "target", "surface": "ceiling", "angle": 90 },
      { "at": 300, "kind": "target", "surface": "ceiling", "angle": 180 },
      { "at": 400, "kind": "target", "surface": "ceiling", "angle": -90 }
    ] },

    // A bend, to see the ring turn.
    { "length": 560, "turn": 60, "obstacles": [                     // 2080 - 2640
      { "at": 150, "angle": 0, "width": 9 },
      { "at": 320, "surface": "ceiling", "angle": 0, "width": 9 }
    ] },

    // Middling room, then a squeeze: the same bore with the core grown out toward the ship, so the
    // jump is shorter and the wall overhead is close enough to read on the approach.
    { "length": 460, "section": "ring", "obstacles": [              // 2640 - 3100
      { "at": 240, "angle": 0, "width": 9 },
      { "at": 380, "surface": "ceiling", "angle": 0, "width": 9 }
    ] },
    { "length": 460, "section": "ring-tight", "obstacles": [        // 3100 - 3560
      { "at": 250, "angle": 0, "width": 9 },
      { "at": 380, "surface": "ceiling", "angle": 0, "width": 9 }
    ] },

    // A squarish ring: flat-ish walls above and below, with corners to read.
    { "length": 560, "section": "ring-box", "obstacles": [          // 3560 - 4120
      { "at": 220, "angle": 0, "width": 10 },
      { "at": 380, "surface": "ceiling", "angle": 0, "width": 10 }
    ] },

    // A shield on the core, so there is a reason to be up there, and then a stretch that brings the
    // player back down before the ring closes - a core that shrinks away takes its wall with it.
    { "length": 460, "section": "ring-tall", "pickups": [           // 4120 - 4580
      { "at": 180, "kind": "shield", "surface": "ceiling", "angle": 0 }
    ], "obstacles": [
      { "at": 360, "surface": "ceiling", "angle": 0, "width": 40 }
    ] },

    // The core shrinks away again and the bore closes back to an ordinary tube.
    { "length": 200, "section": "mouth" },                          // 4580 - 4780
    { "length": 340, "section": "tube" },                           // 4780 - 5120
    { "length": 300 }                                               // 5120 - 5420
  ]
}
