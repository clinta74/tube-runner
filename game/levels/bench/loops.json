{
  "name": "Loops",
  "speed": 110,
  "segmentLength": 60,

  // A trial for an early wireframe level, not part of the run yet. Play it with
  //   ./play.ps1 -Level bench/loops.json
  // Loops and switchbacks on a single track, to see how the see-through style reads when the track
  // bends back on itself and every other part of it is in view.
  //
  // A loop flown at one steady rate closes into a circle and passes through its own entry. So every
  // loop here is built from pieces with different rates - a sideways turn over the top of a vertical
  // loop, a climb through a flat one - which carries the exit clear of the way in. TrackClearanceTests
  // checks that no part of the track comes within a tube's width of another.
  "theme": {
    "wire": true,
    "seamLight": "#7ff0ff",
    "far": "#000000",
    "ship": "#ffffff",
    "block": "#ff8a3a",
    "target": "#ff3a6a",
    "breakable": "#7cffb0",
    "fadeStart": 60,
    "fadeEnd": 700,
    "glow": 0.5
  },

  "sections": {
    "tube": { "radius": 6 }
  },

  "start": "tube",
  "track": [
    { "length": 260 },                                              //    0 -  260

    // A vertical loop. It swings right going up over the top and back left coming down, so the way
    // out runs beside the way in instead of through it, pointing the same way it came in. Turning the
    // same way on both quarters, or on every quarter, lands the exit back on the entry.
    { "length": 160, "climb": 90 },                                 //  260 -  420
    { "length": 160, "climb": 90, "turn": 30 },                     //  420 -  580
    { "length": 160, "climb": 90, "turn": -30 },                    //  580 -  740
    { "length": 160, "climb": 90 },                                 //  740 -  900

    { "length": 220, "obstacles": [                                 //  900 - 1120
      { "at": 110, "kind": "target", "angle": 0, "count": 3, "spacing": 50, "angleStep": 120 }
    ] },

    // Switchbacks: a hairpin right, a straight back the way we came, a hairpin left. The legs run
    // side by side, so the next one is always in view through the wall.
    { "length": 300, "turn": 180 },                                 // 1120 - 1420
    { "length": 220, "obstacles": [                                 // 1420 - 1640
      { "at": 80,  "angle": 0,   "width": 8 },
      { "at": 160, "angle": 180, "width": 8 }
    ] },
    { "length": 300, "turn": -180 },                                // 1640 - 1940
    { "length": 220, "obstacles": [                                 // 1940 - 2160
      { "at": 110, "kind": "target", "angle": 90 }
    ] },
    { "length": 300, "turn": 180 },                                 // 2160 - 2460
    { "length": 200 },                                              // 2460 - 2660

    // A flat loop that climbs as it goes round, so it passes over its own entry rather than through it.
    { "length": 320, "turn": 180, "climb": 30 },                    // 2660 - 2980
    { "length": 320, "turn": 180, "climb": -30, "obstacles": [      // 2980 - 3300
      { "at": 160, "angle": 90, "width": 8 }
    ] },

    { "length": 220 },                                              // 3300 - 3520

    // A dive loop, the other way up, swinging left and back over the bottom.
    { "length": 160, "climb": -90 },                                // 3520 - 3680
    { "length": 160, "climb": -90, "turn": -30 },                   // 3680 - 3840
    { "length": 160, "climb": -90, "turn": 30 },                    // 3840 - 4000
    { "length": 160, "climb": -90 },                                // 4000 - 4160

    { "length": 400 }                                               // 4160 - 4560  run-out
  ]
}
