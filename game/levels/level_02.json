{
  "name": "Neon Run",
  "speed": 100,
  "timeLimit": 31,
  "segmentLength": 60,

  "theme": {
    "darks": ["#0c0620", "#041421", "#140418"],
    "lights": ["#c02aa8", "#29b8cc", "#ccb029"],
    "seamDark": "#000000",
    "seamLight": "#ffffff",
    "far": "#000000",
    "ship": "#ffffff",
    "block": "#dfe6ff",
    "target": "#ff2050",
    "fadeStart": 40,
    "fadeEnd": 360,
    "glow": 0.6
  },

  "sections": {
    "tube":     { "radius": 5.5 },
    "oval":     { "halfWidth": 9, "halfHeight": 4 },
    "box":      { "halfWidth": 9, "halfHeight": 4, "squareness": 1 },
    "flat":     { "radius": 5.5, "opening": 1 },
    "box-flat": { "halfWidth": 9, "halfHeight": 4, "squareness": 1, "opening": 1 },
    "tall-chamber": { "halfWidth": 6.5, "halfHeight": 13, "squareness": 0.6 }
  },

  "start": "tube",
  "track": [
    { "length": 200 },                                              //    0 - 200
    { "length": 150, "turn": -50 },                                 //  200 - 350
    { "length": 150, "turn": 50, "climb": -12 },                    //  350 - 500

    { "length": 100, "section": "flat", "speed": 125 },             //  500 - 600
    { "length": 500 },                                              //  600 - 1100
    { "length": 360, "section": "tube" },                           // 1100 - 1460

    { "length": 100, "section": "oval", "turn": 20, "speed": 110 }, // 1460 - 1560
    { "length": 250, "turn": -60 },                                 // 1560 - 1810
    { "length": 100, "section": "tube", "turn": 20 },               // 1810 - 1910
    { "length": 200, "turn": 30, "climb": 20 },                     // 1910 - 2110

    { "length": 100, "section": "box", "speed": 125 },              // 2110 - 2210
    { "length": 200, "turn": -40 },                                 // 2210 - 2410
    { "length": 100, "section": "box-flat", "speed": 145 },         // 2410 - 2510
    { "length": 400 },                                              // 2510 - 2910
    { "length": 360, "section": "tube" },                           // 2910 - 3270

    { "length": 250, "turn": 60 },                                  // 3270 - 3520

    // Stretch tall, fork over/under, merge, and narrow back down.
    { "length": 100, "section": "tall-chamber", "speed": 160 },     // 3520 - 3620
    { "length": 400, "split": {                                     // 3620 - 4020
        "section": "tube",
        "branches": [
          { "offsets": [[0, 0, -7], [120, 0, -20], [280, 0, -20], [400, 0, -7]] },
          { "offsets": [[0, 0, 7], [120, -6, 20], [280, 6, 20], [400, 0, 7]] }
        ]
    } },
    { "length": 100, "section": "tube" },                           // 4020 - 4120
    { "length": 200 }                                               // 4120 - 4320
  ],

  "obstacles": [
    { "at": 260, "angle": 0, "count": 4, "spacing": 50, "angleStep": 60 },
    { "at": 300, "kind": "target", "angle": 180, "count": 3, "spacing": 50 },

    // Flat: a gap, a jump to the ceiling, a zigzag up there, and a jump back.
    { "at": 650, "x": -8, "width": 14 },
    { "at": 650, "x": 12, "width": 10 },
    { "at": 720, "width": 80, "height": 2.5 },
    { "at": 800, "surface": "ceiling", "x": 5, "width": 12, "count": 3, "spacing": 60, "xStep": -10 },
    { "at": 820, "kind": "target", "surface": "ceiling", "x": -12, "count": 3, "spacing": 60, "xStep": 12 },
    { "at": 1020, "surface": "ceiling", "width": 80, "height": 2.5 },
    { "at": 1060, "kind": "target" },

    { "at": 1590, "angle": 60, "count": 4, "spacing": 55, "angleStep": -40 },
    { "at": 1640, "kind": "target", "angle": 180, "count": 3, "spacing": 55 },
    { "at": 1940, "angle": 0, "count": 6, "spacing": 30, "angleStep": 60 },

    { "at": 2240, "width": 6 },
    { "at": 2300, "x": -6, "width": 6 },
    { "at": 2300, "x": 6, "width": 6 },
    { "at": 2360, "kind": "target", "angle": 90 },
    { "at": 2360, "kind": "target", "angle": -90 },

    { "at": 2560, "x": -15, "width": 14, "count": 6, "spacing": 45, "xStep": 6 },
    { "at": 2840, "width": 80, "height": 2.5 },
    { "at": 2880, "kind": "target", "surface": "ceiling" },

    { "at": 3330, "kind": "target", "angle": 0, "count": 5, "spacing": 40, "angleStep": 72 },
    { "at": 3580, "angle": 180 },

    // Over/under fork: a spiral of blocks below, targets above.
    { "at": 3730, "branch": 0, "angle": 0, "count": 5, "spacing": 45, "angleStep": 72 },
    { "at": 3750, "branch": 1, "kind": "target", "angle": 180, "count": 4, "spacing": 50 },
    { "at": 4230, "kind": "target" }
  ]
}
