{
  "name": "Power Up",
  "next": "level_03.json",
  "speed": 80,
  "segmentLength": 60,

  // Still round: introduces breakable blocks and every power-up.
  "theme": {
    "darks": ["#2a1a14", "#1f2622", "#30201c"],
    "lights": ["#c77b4a", "#6f9c86", "#b89a5e"],
    "seamDark": "#140c08",
    "seamLight": "#ffd08a",
    "far": "#0a0604",
    "ship": "#ffd08a",
    "block": "#c6bda9",
    "target": "#ff4a3d",
    "breakable": "#86c5e8",
    "fadeStart": 30,
    "fadeEnd": 320,
    "glow": 0
  },

  "sections": {
    "tube": { "radius": 6.5 },
    "oval": { "halfWidth": 9, "halfHeight": 5 }
  },

  "start": "tube",
  "track": [
    { "length": 150 },                                              //    0 - 150

    // Blue blocks break under fire; "hits" is how many shots they take.
    { "length": 200, "turn": 30, "obstacles": [                     //  150 - 350
      { "at": 60, "hits": 1 },
      { "at": 130, "hits": 2, "angle": 45 },
      { "at": 130, "hits": 2, "angle": -45 }
    ] },

    // A full ring of breakable blocks: shoot a hole and fly through it.
    { "length": 200, "turn": -35, "climb": 10, "pickups": [         //  350 - 550
      { "at": 30, "kind": "shield" }
    ], "obstacles": [
      { "at": 120, "hits": 1, "angle": 0, "count": 8, "angleStep": 45, "width": 4.2 }
    ] },

    // Rapid fire, then blocks that need a lot of shots.
    { "length": 100, "section": "oval", "pickups": [                //  550 - 650
      { "at": 40, "kind": "rapid-fire" }
    ] },
    { "length": 250, "turn": 30, "obstacles": [                     //  650 - 900
      { "at": 30, "hits": 4, "count": 3, "spacing": 40 },
      { "at": 150, "hits": 3, "angle": 0, "count": 8, "angleStep": 45, "width": 5 }
    ] },

    { "length": 100, "section": "tube", "pickups": [                //  900 - 1000
      { "at": 50, "kind": "full-shields" }
    ] },

    // The ring gun sweeps the whole tube: press E (or gamepad Y) at a ring of targets.
    { "length": 250, "turn": -40, "pickups": [                      // 1000 - 1250
      { "at": 20, "kind": "ring-gun" }
    ], "obstacles": [
      { "at": 110, "kind": "target", "angle": 0, "count": 8, "angleStep": 45 },
      { "at": 200, "kind": "target", "angle": 22.5, "count": 8, "angleStep": 45 }
    ] },

    // An extra shield slot, parked on the ceiling.
    { "length": 200, "turn": 25, "climb": -10, "pickups": [         // 1250 - 1450
      { "at": 80, "kind": "shield-slot", "angle": 180 }
    ], "obstacles": [
      { "at": 40, "angle": -30, "count": 3, "angleStep": 30 }
    ] },

    // Mixed ring: white blocks are solid, blue ones can be shot out.
    { "length": 200, "obstacles": [                                 // 1450 - 1650
      { "at": 60, "angle": 0, "count": 4, "angleStep": 90, "width": 4.2 },
      { "at": 60, "hits": 2, "angle": 45, "count": 4, "angleStep": 90, "width": 4.2 },
      { "at": 150, "kind": "target", "count": 3, "spacing": 15 }
    ] },

    { "length": 250 }                                               // 1650 - 1900
  ]
}
