<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>TubeRunner.Game</RootNamespace>
    <!-- The release version, stamped by "tube export" given a version, through the GameVersion environment
         variable; the update check reads it back from the assembly. Unstamped, it stays 0.0.0 - a
         development build, which never checks. Left to .NET's own default of 1.0.0, every
         development build would look like a release from the future. -->
    <Version>0.0.0</Version>
    <Version Condition="'$(GameVersion)' != ''">$(GameVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\src\TubeRunner.Core\TubeRunner.Core.csproj" />
  </ItemGroup>
</Project>
